+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lock();
+        defer core.renderer_state.mutex.unlock();
+        const term = &core.io.terminal;
+        if (term.screens.active_key != .primary) return false;
+        const screen = term.screens.active;
+        const region = screen.command_blocks.region(screen, id) orelse return false;
+        screen.pages.scroll(.{ .pin = region.output });
+        term.flags.dirty.clear = true;
+        if (select) {
+            const selection = @import("../terminal/CommandBlocks.zig").selection(region.output, region.end);
