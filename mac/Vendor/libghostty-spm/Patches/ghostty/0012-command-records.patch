diff --git a/src/terminal/CommandBlocks.zig b/src/terminal/CommandBlocks.zig
new file mode 100644
--- /dev/null
+++ b/src/terminal/CommandBlocks.zig
@@ -0,0 +1,205 @@
+const std = @import("std");
+const Screen = @import("Screen.zig");
+const PageList = @import("PageList.zig");
+const Selection = @import("Selection.zig");
+const SemanticPrompt = @import("osc/parsers/semantic_prompt.zig");
+const Pin = PageList.Pin;
+const Allocator = std.mem.Allocator;
+const Self = @This();
+
+pub const Record = struct {
+    blockID: u64,
+    command: [:0]const u8,
+    workingDirectory: ?[]const u8,
+    startedAtMilliseconds: i64,
+    finishedAtMilliseconds: ?i64 = null,
+    durationNanos: ?u64 = null,
+    exitCode: ?i32 = null,
+    hasLocation: bool = true,
+    started: ?std.time.Instant,
+    prompt: *Pin,
+    input: *Pin,
+    output: *Pin,
+    end: ?*Pin = null,
+
+    pub fn deinit(self: *Record, screen: *Screen) void {
+        screen.alloc.free(self.command);
+        if (self.workingDirectory) |directory| screen.alloc.free(directory);
+        screen.pages.untrackPin(self.prompt);
+        screen.pages.untrackPin(self.input);
+        screen.pages.untrackPin(self.output);
+        if (self.end) |end| screen.pages.untrackPin(end);
+    }
+};
+
+pub const Region = struct { prompt: Pin, input: Pin, output: Pin, end: Pin };
+
+records: std.ArrayList(Record) = .empty,
+pending_prompt: ?*Pin = null,
+pending_input: ?*Pin = null,
+active_id: ?u64 = null,
+next_id: u64 = 0,
+revision: u64 = 0,
+
+pub fn deinit(self: *Self, screen: *Screen) void {
+    for (self.records.items) |*record| record.deinit(screen);
+    self.records.deinit(screen.alloc);
+    self.clearPending(screen);
+    self.* = .{};
+}
+
+fn clearPending(self: *Self, screen: *Screen) void {
+    if (self.pending_prompt) |pin| screen.pages.untrackPin(pin);
+    if (self.pending_input) |pin| screen.pages.untrackPin(pin);
+    self.pending_prompt = null;
+    self.pending_input = null;
+}
+
+pub fn invalidate(self: *Self, screen: *Screen) void {
+    self.clearPending(screen);
+    for (self.records.items) |*record| record.hasLocation = false;
+    self.revision +%= 1;
+}
+
+pub fn find(self: *Self, id: u64) ?*Record {
+    for (self.records.items) |*record| if (record.blockID == id) return record;
+    return null;
+}
+
+pub fn region(self: *Self, screen: *Screen, id: u64) ?Region {
+    const record = self.find(id) orelse return null;
+    return recordRegion(screen, record);
+}
+
+fn recordRegion(screen: *Screen, record: *const Record) ?Region {
+    if (!record.hasLocation or record.prompt.garbage or record.input.garbage or record.output.garbage) return null;
+    const end = if (record.end) |pin| blk: {
+        if (pin.garbage) return null;
+        break :blk pin.*;
+    } else screen.cursor.page_pin.*;
+    const result: Region = .{ .prompt = record.prompt.*, .input = record.input.*, .output = record.output.*, .end = end };
+    if (result.input.before(result.prompt) or result.output.before(result.input) or result.end.before(result.output)) return null;
+    return result;
+}
+
+pub fn selection(start: Pin, end: Pin) ?Selection {
+    if (start.eql(end) or end.before(start)) return null;
+    return Selection.init(start, end.leftWrap(1) orelse return null, false);
+}
+
+fn boundedUtf8(value: []const u8, max: usize) []const u8 {
+    var length = @min(value.len, max);
+    while (length > 0 and !std.unicode.utf8ValidateSlice(value[0..length])) : (length -= 1) {}
+    return value[0..length];
+}
+
+pub fn invalidateRange(self: *Self, screen: *Screen, start: Pin, end: Pin) void {
+    var changed = false;
+    for (self.records.items) |*record| {
+        if (record.finishedAtMilliseconds == null) continue;
+        const bounds = recordRegion(screen, record) orelse continue;
+        if (!end.before(bounds.prompt) and start.before(bounds.end)) {
+            record.hasLocation = false;
+            changed = true;
+        }
+    }
+    if (changed) self.revision +%= 1;
+}
+
+pub fn invalidateWrittenRow(self: *Self, screen: *Screen) void {
+    // Normal output is after the last completed block; only cursor rewrites
+    // need to inspect old records, keeping the print path constant time.
+    var index = self.records.items.len;
+    while (index > 0) {
+        index -= 1;
+        const record = &self.records.items[index];
+        if (record.end) |end| {
+            const cursor = screen.cursor.page_pin.*;
+            if (!end.garbage and cursor.before(end.*)) {
+                var right = cursor;
+                right.x = screen.pages.cols - 1;
+                self.invalidateRange(screen, cursor, right);
+            }
+            return;
+        }
+    }
+}
+
+fn decodedCommand(alloc: Allocator, encoded: []const u8) ![:0]const u8 {
+    if (encoded.len > 49_152) return error.OutOfMemory;
+    const buffer = try alloc.dupe(u8, encoded);
+    defer alloc.free(buffer);
+    const decoded = std.Uri.percentDecodeInPlace(buffer);
+    var length = @min(decoded.len, 16_384);
+    while (length > 0 and !std.unicode.utf8ValidateSlice(decoded[0..length])) : (length -= 1) {}
+    return alloc.dupeZ(u8, decoded[0..length]);
+}
+
+pub fn observe(self: *Self, screen: *Screen, cmd: SemanticPrompt.Command, directory: ?[:0]const u8) !void {
+    switch (cmd.action) {
+        .fresh_line_new_prompt => {
+            if (self.active_id != null) self.active_id = null;
+            self.clearPending(screen);
+            self.pending_prompt = try screen.pages.trackPin(screen.cursor.page_pin.*);
+        },
+        .end_prompt_start_input, .end_prompt_start_input_terminate_eol => {
+            if (self.pending_prompt == null) return;
+            if (self.pending_input) |pin| screen.pages.untrackPin(pin);
+            self.pending_input = try screen.pages.trackPin(screen.cursor.page_pin.*);
+        },
+        .end_input_start_output => {
+            if (self.active_id != null) return;
+            const prompt = self.pending_prompt orelse return;
+            const input = self.pending_input orelse return;
+            if (prompt.garbage or input.garbage) {
+                self.clearPending(screen);
+                return;
+            }
+            const output = try screen.pages.trackPin(screen.cursor.page_pin.*);
+            errdefer screen.pages.untrackPin(output);
+            const command = if (cmd.readOption(.cmdline_url)) |encoded|
+                try decodedCommand(screen.alloc, encoded)
+            else if (selection(input.*, output.*)) |sel|
+                try screen.selectionString(screen.alloc, .{ .sel = sel, .trim = true })
+            else
+                try screen.alloc.dupeZ(u8, "");
+            errdefer screen.alloc.free(command);
+            const pwd: ?[]const u8 = if (directory) |value| try screen.alloc.dupe(u8, boundedUtf8(value, 4_096)) else null;
+            errdefer if (pwd) |value| screen.alloc.free(value);
+            self.next_id +%= 1;
+            if (self.next_id == 0) self.next_id = 1;
+            try self.records.append(screen.alloc, .{
+                .blockID = self.next_id,
+                .command = command,
+                .workingDirectory = pwd,
+                .startedAtMilliseconds = std.time.milliTimestamp(),
+                .started = std.time.Instant.now() catch null,
+                .prompt = prompt,
+                .input = input,
+                .output = output,
+            });
+            self.active_id = self.next_id;
+            self.pending_prompt = null;
+            self.pending_input = null;
+            if (self.records.items.len > 2_000) {
+                var old = self.records.orderedRemove(0);
+                old.deinit(screen);
+            }
+            self.revision +%= 1;
+        },
+        .end_command => {
+            const id = self.active_id orelse return;
+            const record = self.find(id) orelse return;
+            if (record.end) |pin| screen.pages.untrackPin(pin);
+            record.end = try screen.pages.trackPin(screen.cursor.page_pin.*);
+            record.finishedAtMilliseconds = std.time.milliTimestamp();
+            if (record.started) |start| {
+                if (std.time.Instant.now() catch null) |end| record.durationNanos = end.since(start);
+            }
+            record.exitCode = cmd.readOption(.exit_code);
+            self.active_id = null;
+            self.revision +%= 1;
+        },
+        else => {},
+    }
+}
