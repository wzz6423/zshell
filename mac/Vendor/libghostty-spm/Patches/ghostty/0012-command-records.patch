+    export fn ghostty_surface_command_at(surface: *Surface, x: f64, y: f64) u64 {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lock();
+        defer core.renderer_state.mutex.unlock();
+        if (core.io.terminal.screens.active_key != .primary) return 0;
+        const screen = core.io.terminal.screens.active;
+        const position = core.posToViewport(x, y);
+        const pin = screen.pages.pin(.{ .viewport = .{ .x = position.x, .y = position.y } }) orelse return 0;
+        var index = screen.command_blocks.records.items.len;
+        while (index > 0) {
+            index -= 1;
+            const record = screen.command_blocks.records.items[index];
+            const region = screen.command_blocks.region(screen, record.blockID) orelse continue;
+            if (!pin.before(region.prompt) and pin.before(region.end)) return record.blockID;
+        }
+        return 0;
