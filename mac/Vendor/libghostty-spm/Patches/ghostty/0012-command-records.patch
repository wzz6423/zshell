+        const term = &surface.core_surface.io.terminal;
+        if (term.screens.active_key != .primary or part > 2) return false;
+        const screen = term.screens.active;
+        const region = screen.command_blocks.region(screen, id) orelse return false;
+        const text = if (part == 0)
