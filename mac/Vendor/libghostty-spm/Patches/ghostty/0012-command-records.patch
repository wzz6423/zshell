+    stream.nextSlice("one\r\ntwo\r\nthree\r\nfour\r\nfive\r\n");
+    for ([_]u16{ 8, 40, 12, 24 }) |columns| {
+        try term.resize(testing.allocator, columns, 4);
+        const region = screen.command_blocks.region(screen, record.blockID).?;
+        const selection = @import("CommandBlocks.zig").selection(region.output, region.end).?;
+        const text = try screen.selectionString(testing.allocator, .{ .sel = selection });
+        defer testing.allocator.free(text);
+        try testing.expectEqualStrings("abcdefghijklmnop", text);
+    }
+    screen.command_blocks.invalidate(screen);
+    try testing.expect(screen.command_blocks.region(screen, record.blockID) == null);
+}
+
+test "zshell command blocks invalidate overwritten and erased output" {
+    var term = try Terminal.init(testing.allocator, .{ .cols = 24, .rows = 4 });
+    defer term.deinit(testing.allocator);
+    var stream = term.vtStream();
+    defer stream.deinit();
+    stream.nextSlice("\x1b]133;A\x07> \x1b]133;B\x07echo one\r\n\x1b]133;C\x07result\r\n\x1b]133;D;0\x07");
+    const screen = term.screens.active;
+    const id = screen.command_blocks.records.items[0].blockID;
+    try testing.expect(screen.command_blocks.region(screen, id) != null);
+    stream.nextSlice("\x1b[2;1H\x1b[2Kreplacement");
+    try testing.expect(screen.command_blocks.region(screen, id) == null);
+    try testing.expectEqualStrings("echo one", screen.command_blocks.records.items[0].command);
+}
+
+test "zshell command blocks accept bounded long Unicode metadata" {
+    var term = try Terminal.init(testing.allocator, .{ .cols = 24, .rows = 4 });
+    defer term.deinit(testing.allocator);
+    var stream = term.vtStream();
+    defer stream.deinit();
+    const encoded = try testing.allocator.alloc(u8, 36_000);
+    defer testing.allocator.free(encoded);
+    for (0..4_000) |offset| @memcpy(encoded[offset * 9 ..][0..9], "%E4%BD%A0");
+    stream.nextSlice("\x1b]133;A\x07> \x1b]133;B\x07long\r\n\x1b]133;C;cmdline_url=");
+    stream.nextSlice(encoded);
+    stream.nextSlice("\x07\x1b]133;D;0\x07");
+    const records = term.screens.active.command_blocks.records.items;
+    try testing.expectEqual(@as(usize, 1), records.len);
+    try testing.expectEqual(@as(usize, 12_000), records[0].command.len);
+    try testing.expect(std.unicode.utf8ValidateSlice(records[0].command));
+}
