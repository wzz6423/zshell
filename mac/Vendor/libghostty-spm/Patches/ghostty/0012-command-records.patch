+                .startedAtMilliseconds = record.startedAtMilliseconds, .finishedAtMilliseconds = record.finishedAtMilliseconds,
+                .durationNanos = record.durationNanos, .exitCode = record.exitCode, .hasLocation = record.hasLocation,
+            }) catch return false;
+        }
+        const json = std.json.Stringify.valueAlloc(global.alloc, records.items, .{}) catch return false;
+        defer global.alloc.free(json);
+        const text = global.alloc.dupeZ(u8, json) catch return false;
+        result.* = .{ .tl_px_x = -1, .tl_px_y = -1, .offset_start = 0, .offset_len = 0, .text = text.ptr, .text_len = text.len };
