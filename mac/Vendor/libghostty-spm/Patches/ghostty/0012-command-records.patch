+        const term = &surface.core_surface.io.terminal;
+        if (term.screens.active_key != .primary) return false;
+        const screen = term.screens.active;
+        const region = screen.command_blocks.region(screen, id) orelse return false;
+        result.* = .{ .prompt = commandPosition(screen, region.prompt) orelse return false,
+            .input = commandPosition(screen, region.input) orelse return false,
+            .output = commandPosition(screen, region.output) orelse return false,
+            .end = commandPosition(screen, region.end) orelse return false };
