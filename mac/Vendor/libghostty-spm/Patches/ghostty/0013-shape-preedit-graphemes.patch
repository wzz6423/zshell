+    try testing.expectEqual(@as(usize, 0), marks.range(0, 0).cp_offset);
+
+    const empty = try Preedit.init(testing.allocator, "");
+    defer empty.deinit(testing.allocator);
+    try testing.expectEqual(@as(usize, 0), empty.codepoints.len);
+}
