+test "preedit retains combining marks and emoji clusters" {
+    const testing = std.testing;
+    const p = try Preedit.init(testing.allocator, "\u{4E2D}\u{1F600}e\u{301}\u{1F469}\u{200D}\u{1F4BB}\u{2708}\u{FE0F}");
+    defer p.deinit(testing.allocator);
+    try testing.expectEqual(@as(usize, 5), p.codepoints.len);
+    try testing.expectEqual(@as(usize, 9), p.width());
+    try testing.expectEqualSlices(u21, &.{0x301}, p.codepoints[2].grapheme);
+    try testing.expectEqualSlices(u21, &.{ 0x200D, 0x1F4BB }, p.codepoints[3].grapheme);
+    try testing.expectEqualSlices(u21, &.{0xFE0F}, p.codepoints[4].grapheme);
+    try testing.expect(p.codepoints[4].wide);
+
+    const copy = try p.clone(testing.allocator);
+    defer copy.deinit(testing.allocator);
+    try testing.expectEqualSlices(u21, p.codepoints[3].grapheme, copy.codepoints[3].grapheme);
+    try testing.expect(p.codepoints[3].grapheme.ptr != copy.codepoints[3].grapheme.ptr);
+}
