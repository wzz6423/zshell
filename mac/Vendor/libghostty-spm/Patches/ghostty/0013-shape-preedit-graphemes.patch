+    const p = try Preedit.init(testing.allocator, "\u{2708}\u{FE0F}\u{231A}\u{FE0E}\u{1F1E8}\u{1F1F3}");
+    defer p.deinit(testing.allocator);
+    try testing.expectEqual(@as(usize, 3), p.codepoints.len);
+    try testing.expectEqual(@as(usize, 5), p.width());
+    try testing.expect(!p.codepoints[1].wide);
+    try testing.expectEqualSlices(u21, &.{0xFE0E}, p.codepoints[1].grapheme);
+    try testing.expectEqualSlices(u21, &.{0x1F1F3}, p.codepoints[2].grapheme);
+}
+
+test "preedit trims whole clusters only after using the full row" {
+    const testing = std.testing;
+    const p = try Preedit.init(testing.allocator, "Ae\u{301}\u{1F469}\u{200D}\u{1F4BB}");
+    defer p.deinit(testing.allocator);
+    const shifted = p.range(7, 7);
+    try testing.expectEqual(@as(terminalpkg.size.CellCountInt, 4), shifted.start);
+    try testing.expectEqual(@as(terminalpkg.size.CellCountInt, 7), shifted.end);
+    try testing.expectEqual(@as(usize, 0), shifted.cp_offset);
+
+    const trimmed = p.range(2, 2);
+    try testing.expectEqual(@as(terminalpkg.size.CellCountInt, 0), trimmed.start);
+    try testing.expectEqual(@as(terminalpkg.size.CellCountInt, 2), trimmed.end);
+    try testing.expectEqual(@as(usize, 1), trimmed.cp_offset);
+    try testing.expectEqualSlices(u21, &.{0x301}, p.codepoints[trimmed.cp_offset].grapheme);
+}
+
+test "preedit one column omits wide clusters and retains leading marks" {
+    const testing = std.testing;
+    const wide = try Preedit.init(testing.allocator, "\u{1F469}\u{200D}\u{1F4BB}");
+    defer wide.deinit(testing.allocator);
+    const omitted = wide.range(0, 0);
