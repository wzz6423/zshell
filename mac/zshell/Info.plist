<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This Info.plist is authored by hand (GENERATE_INFOPLIST_FILE = NO) so we
	     own the Bundle* keys instead of letting the generator derive them.
	     PRODUCT_NAME remains lowercase so Xcode and the CLI agree on the
	     executable name. ZSHELL_DISPLAY_NAME supplies Zshell for Release and Zshell
	     Debug for Debug. The release bundle id stays sh.zshell — it's the app's
	     identity for Sparkle and code signing, so it must not change. Dynamic
	     values use build-setting substitution to stay in sync. -->

	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- User-visible name. CFBundleName drives the app menu (bold menu next to
	     the Apple menu); CFBundleDisplayName is what Finder/Dock show. -->
	<key>CFBundleName</key>
	<string>$(ZSHELL_DISPLAY_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(ZSHELL_DISPLAY_NAME)</string>

	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>

	<!-- Finder exposes this app service in a folder's context menu. AppKit
	     forwards the selected paths to ZshellApplicationDelegate.openInZshell. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New $(ZSHELL_DISPLAY_NAME) Project Here</string>
			</dict>
			<key>NSMessage</key>
			<string>openInZshell</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>FilePath</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>

	<!-- Programs running inside the terminal (e.g. Claude Code voice dictation)
	     request mic access attributed to Zshell as the responsible process. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A program running within Zshell would like to use your microphone.</string>

	<!-- Sparkle auto-update configuration.
	     Appcast feed hosted on Cloudflare R2 (releases.zshell.sh); see RELEASING.md. -->
	<key>SUFeedURL</key>
	<string>https://releases.zshell.sh/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>94CIcriCuNHELX8l1CQPW2XUsrBcqp0mr++vw9tXB0Q=</string>
</dict>
</plist>
