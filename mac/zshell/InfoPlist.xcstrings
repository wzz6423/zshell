        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell에서 실행 중인 프로그램이 마이크를 사용하려고 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een programma dat in Zshell wordt uitgevoerd, wil je microfoon gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um programa em execução no Zshell gostaria de usar seu microfone."
