        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Zshell ausgeführtes Programm möchte dein Mikrofon verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Zshell would like to use your microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta en Zshell quiere usar tu micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme exécuté dans Zshell souhaite utiliser votre microphone."
