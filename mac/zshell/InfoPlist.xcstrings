{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Zshell"
          }
        }
      },
      "shouldTranslate": false
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Zshell"
          }
        }
      },
      "shouldTranslate": false
    },
    "NSAppleEventsUsageDescription": {
      "comment": "Privacy prompt shown when a program running in a Zshell terminal requests permission to control another app.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل Zshell في التحكم في تطبيقات أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Zshell ausgeführtes Programm möchte andere Apps steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Zshell would like to control other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta en Zshell quiere controlar otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme exécuté dans Zshell souhaite contrôler d’autres apps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program yang berjalan di Zshell ingin mengontrol app lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma in esecuzione in Zshell vorrebbe controllare altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell内で実行中のプログラムがほかのアプリを制御しようとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell에서 실행 중인 프로그램이 다른 앱을 제어하려고 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een programma dat in Zshell wordt uitgevoerd, wil andere apps aansturen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um programa em execução no Zshell gostaria de controlar outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа, запущенная в Zshell, запрашивает разрешение управлять другими приложениями."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมที่ทำงานใน Zshell ต้องการควบคุมแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell içinde çalışan bir program diğer uygulamaları denetlemek istiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chương trình đang chạy trong Zshell muốn điều khiển các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Zshell 中运行的程序请求控制其他应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Zshell 中執行的程式想要控制其他 App。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy prompt shown when a program running in a Zshell terminal requests camera access.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرغب برنامج يعمل داخل Zshell في استخدام الكاميرا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in Zshell ausgeführtes Programm möchte deine Kamera verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running within Zshell would like to use your camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que se ejecuta en Zshell quiere usar tu cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme exécuté dans Zshell souhaite utiliser votre caméra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program yang berjalan di Zshell ingin menggunakan kamera Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma in esecuzione in Zshell vorrebbe usare la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell内で実行中のプログラムがカメラを使用しようとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell에서 실행 중인 프로그램이 카메라를 사용하려고 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een programma dat in Zshell wordt uitgevoerd, wil je camera gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um programa em execução no Zshell gostaria de usar sua câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа, запущенная в Zshell, запрашивает доступ к камере."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมที่ทำงานใน Zshell ต้องการใช้กล้องของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell içinde çalışan bir program kameranızı kullanmak istiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chương trình đang chạy trong Zshell muốn sử dụng camera của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Zshell 中运行的程序请求使用你的摄像头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Zshell 中執行的程式想要使用你的相機。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
