            "state": "translated",
            "value": "Tapez un repère pour ouvrir. Tab passe à la copie. Échap annule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Label zum Öffnen eingeben. Tab wechselt zum Kopieren. Esc bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una etiqueta para abrir. Tab cambia a copiar. Esc cancela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite uma etiqueta para abrir. Tab muda para copiar. Esc cancela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita un’etichetta per aprire. Tab passa alla copia. Esc annulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ een label om te openen. Tab schakelt naar kopiëren. Esc annuleert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите метку для открытия. Tab — копирование, Esc — отмена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب التسمية للفتح. Tab للتبديل إلى النسخ. Esc للإلغاء."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พิมพ์ป้ายเพื่อเปิด Tab เปลี่ยนเป็นคัดลอก Esc ยกเลิก"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik label untuk membuka. Tab beralih ke salin. Esc membatalkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập nhãn để mở. Tab chuyển sang sao chép. Esc để hủy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmak için etiketi yazın. Tab kopyalamaya geçer. Esc iptal eder."
          }
        }
      }
    },
