          "stringUnit": {
            "state": "translated",
            "value": "Envoie les combinaisons avec Option aux programmes du terminal comme raccourcis Meta, au lieu de saisir du texte macOS"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim kombinasi Option ke program terminal sebagai pintasan Meta alih-alih input teks macOS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le combinazioni con Opzione ai programmi del terminale come scorciatoie Meta anziché come input di testo macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionキーの組み合わせを、macOSの文字入力ではなくMetaショートカットとしてターミナルに送ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Option 키 조합을 macOS 텍스트 입력 대신 Meta 단축키로 터미널 프로그램에 전송합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt combinaties met Option als Meta-sneltoetsen naar terminalprogramma's in plaats van als macOS-tekstinvoer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia combinações com Option aos programas do terminal como atalhos Meta em vez de entrada de texto do macOS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаёт сочетания с Option терминальным программам как Meta вместо ввода текста macOS"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งชุดปุ่ม Option ไปยังโปรแกรมเทอร์มินัลเป็นปุ่มลัด Meta แทนการป้อนข้อความของ macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Option tuş birleşimlerini macOS metin girişi yerine Meta kısayolları olarak terminal programlarına gönderir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi tổ hợp Option đến chương trình terminal dưới dạng phím tắt Meta thay vì nhập văn bản macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Option 键组合作为 Meta 快捷键发送给终端程序，而不是作为 macOS 文本输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Option 鍵組合作為 Meta 快速鍵發送給終端機程式，而不是作為 macOS 文字輸入"
          }
        }
      }
    },
