    "The event stream fell behind. Subscribe again to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event stream fell behind. Subscribe again to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件流处理滞后，请重新订阅后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "事件串流處理落後，請重新訂閱後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントストリームに遅延が生じました。再購読して続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 스트림이 지연되었습니다. 계속하려면 다시 구독하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux d’événements a pris du retard. Abonnez-vous à nouveau pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ereignisstrom ist zurückgefallen. Zum Fortfahren erneut abonnieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo de eventos se ha retrasado. Vuelve a suscribirte para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo de eventos ficou atrasado. Assine novamente para continuar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il flusso di eventi è rimasto indietro. Iscriviti di nuovo per continuare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gebeurtenissenstroom is achtergeraakt. Abonneer opnieuw om verder te gaan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
