    "Install Homebrew to manage recommended tools.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت Homebrew لإدارة الأدوات الموصى بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Homebrew, um empfohlene Werkzeuge zu verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Homebrew para gestionar las herramientas recomendadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Homebrew pour gérer les outils recommandés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal Homebrew untuk mengelola alat yang direkomendasikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Homebrew per gestire gli strumenti consigliati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめツールを管理するには Homebrew をインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 도구를 관리하려면 Homebrew를 설치하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer Homebrew om aanbevolen tools te beheren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Homebrew para gerenciar as ferramentas recomendadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Homebrew для управления рекомендованными инструментами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง Homebrew เพื่อจัดการเครื่องมือแนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen araçları yönetmek için Homebrew yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài Homebrew để quản lý công cụ được đề xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先安装 Homebrew，再管理推荐工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先安裝 Homebrew，再管理推薦工具。"
          }
        }
      }
    },
    "Install Homebrew, then click Refresh to enable one-click installation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت Homebrew، ثم انقر على «تحديث» لتمكين التثبيت بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Homebrew und klicke dann auf „Aktualisieren“, um die Ein-Klick-Installation zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Homebrew y luego pulsa Actualizar para activar la instalación con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Homebrew, puis cliquez sur Actualiser pour activer l'installation en un clic."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal Homebrew, lalu klik Segarkan untuk mengaktifkan instalasi sekali klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Homebrew, poi fai clic su Aggiorna per abilitare l'installazione con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew をインストールしてから「更新」をクリックすると、ワンクリックでツールをインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew를 설치한 후 새로 고침을 클릭하면 원클릭 설치가 활성화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer Homebrew en klik op Ververs om installatie met één klik in te schakelen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Homebrew e clique em Atualizar para ativar a instalação com um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите Homebrew, затем нажмите «Обновить», чтобы включить установку одним нажатием."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง Homebrew แล้วคลิกรีเฟรชเพื่อเปิดใช้การติดตั้งในคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tıklamayla yüklemeyi etkinleştirmek için Homebrew yükleyip Yenile’ye tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài Homebrew rồi nhấp Làm mới để bật cài đặt một nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Homebrew 后点击“刷新”，即可一键安装工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 Homebrew 後點擊“刷新”，即可一鍵安裝工具。"
          }
        }
      }
    },
