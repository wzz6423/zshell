    "This terminal predates Zshell automation. Open a new terminal and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت هذه الطرفية قبل أتمتة Zshell. افتح طرفية جديدة وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Terminal wurde vor der Zshell-Automatisierung gestartet. Öffne ein neues Terminal und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este terminal es anterior a la automatización de Zshell. Abre un terminal nuevo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal est antérieur à l'automatisation Zshell. Ouvrez un nouveau terminal et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal ini dibuat sebelum otomatisasi Zshell tersedia. Buka terminal baru dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo terminale precede l'automazione di Zshell. Apri un nuovo terminale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルはZshellの自動化機能が有効になる前に起動されました。新しいターミナルを開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널은 Zshell 자동화 도입 전에 생성되었습니다. 새 터미널을 열고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze terminal is gestart vóór de Zshell-automatisering. Open een nieuwe terminal en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este terminal é anterior à automação do Zshell. Abra um novo terminal e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот терминал создан до появления автоматизации Zshell. Откройте новый терминал и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลนี้สร้างก่อนระบบอัตโนมัติของ Zshell เปิดเทอร์มินัลใหม่แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu terminal Zshell otomasyonundan önce oluşturuldu. Yeni terminal açıp tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal này được tạo trước khi có tự động hóa Zshell. Mở terminal mới rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端在 Zshell 自动化功能启用前已启动。请打开新终端后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機在 Zshell 自動化功能啟用前已啟動。請開啟新終端機後重試。"
          }
        }
      }
    },
