          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminais reabertos mostram seu histórico anterior acima de um novo shell"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно открытые терминалы показывают предыдущую историю прокрутки над новой оболочкой"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทอร์มินัลที่เปิดอีกครั้งจะแสดงประวัติการเลื่อนเดิมเหนือเชลล์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden açılan terminaller yeni kabuğun üzerinde önceki kaydırma geçmişini gösterir"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal mở lại hiển thị lịch sử cuộn cũ phía trên shell mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
