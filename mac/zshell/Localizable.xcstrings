    "Sharing could not start. Check the sharing log and Tailscale connection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing could not start. Check the sharing log and Tailscale connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动共享。请检查共享日志和 Tailscale 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動共享。請檢查共享記錄和 Tailscale 連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を開始できませんでした。共有ログと Tailscale 接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유를 시작할 수 없습니다. 공유 로그와 Tailscale 연결을 확인하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le partage. Vérifiez le journal de partage et la connexion Tailscale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe konnte nicht gestartet werden. Prüfen Sie das Freigabeprotokoll und die Tailscale-Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el uso compartido. Comprueba el registro de uso compartido y la conexión de Tailscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o compartilhamento. Verifique o registro de compartilhamento e a conexão do Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la condivisione. Controlla il registro di condivisione e la connessione Tailscale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen kon niet worden gestart. Controleer het deellogboek en de Tailscale-verbinding."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить общий доступ. Проверьте журнал общего доступа и подключение Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء المشاركة. تحقق من سجل المشاركة واتصال Tailscale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มแชร์ไม่ได้ โปรดตรวจสอบบันทึกการแชร์และการเชื่อมต่อ Tailscale"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi tidak dapat dimulai. Periksa log berbagi dan koneksi Tailscale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bắt đầu chia sẻ. Hãy kiểm tra nhật ký chia sẻ và kết nối Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım başlatılamadı. Paylaşım günlüğünü ve Tailscale bağlantısını denetleyin."
          }
        }
      }
    },
    "Sharing is off. Tailscale verifies the machine owner and any allowed users. Stopping sharing ends its sessions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is off. Tailscale verifies the machine owner and any allowed users. Stopping sharing ends its sessions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已关闭。Tailscale 会验证设备所有者和获准用户。停止共享会结束共享会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享已關閉。Tailscale 會驗證裝置擁有者和獲准使用者。停止共享會結束共享工作階段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有はオフです。Tailscale はデバイスの所有者と許可されたユーザーを確認します。共有を停止すると共有セッションが終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유가 꺼져 있습니다. Tailscale은 기기 소유자와 허용된 사용자를 확인합니다. 공유를 중지하면 공유 세션이 종료됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage est désactivé. Tailscale vérifie le propriétaire de l’appareil et les utilisateurs autorisés. L’arrêt du partage met fin aux sessions partagées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe ist deaktiviert. Tailscale prüft den Geräteeigentümer und zugelassene Benutzer. Beim Beenden der Freigabe werden ihre Sitzungen beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido está desactivado. Tailscale verifica al propietario del equipo y a los usuarios permitidos. Dejar de compartir termina sus sesiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento está desativado. O Tailscale verifica o proprietário do dispositivo e os usuários permitidos. Parar o compartilhamento encerra suas sessões."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione è disattivata. Tailscale verifica il proprietario del dispositivo e gli utenti autorizzati. Interrompere la condivisione termina le sue sessioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delen is uitgeschakeld. Tailscale controleert de apparaateigenaar en toegestane gebruikers. Stoppen met delen beëindigt de gedeelde sessies."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий доступ выключен. Tailscale проверяет владельца устройства и разрешённых пользователей. Остановка общего доступа завершает его сеансы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشاركة متوقفة. يتحقق Tailscale من مالك الجهاز والمستخدمين المسموح لهم. يؤدي إيقاف المشاركة إلى إنهاء جلساتها."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการแชร์อยู่ Tailscale จะตรวจสอบเจ้าของอุปกรณ์และผู้ใช้ที่อนุญาต การหยุดแชร์จะสิ้นสุดเซสชันการแชร์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi dinonaktifkan. Tailscale memverifikasi pemilik perangkat dan pengguna yang diizinkan. Menghentikan berbagi mengakhiri sesinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ đang tắt. Tailscale xác minh chủ sở hữu thiết bị và người dùng được phép. Dừng chia sẻ sẽ kết thúc các phiên chia sẻ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım kapalı. Tailscale, cihaz sahibini ve izin verilen kullanıcıları doğrular. Paylaşımı durdurmak paylaşım oturumlarını sonlandırır."
          }
        }
      }
    },
    "Sharing requires a private state directory.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
