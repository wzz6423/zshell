            "value": "Use um diretório relativo ao projeto sem “..” ou um diretório absoluto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una directory relativa al progetto senza “..”, oppure una directory assoluta."
          }
