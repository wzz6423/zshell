    "Project already open. Focused it in the sidebar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشروع مفتوح بالفعل. تم التركيز عليه في الشريط الجانبي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt bereits geöffnet. In der Seitenleiste fokussiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto ya está abierto. Se ha enfocado en la barra lateral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projet déjà ouvert. Sélectionné dans la barre latérale."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek sudah terbuka. Fokus dipindahkan ke proyek di bilah samping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progetto già aperto. Selezionato nella barra laterale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトはすでに開いています。サイドバーでそのプロジェクトに移動しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 열린 프로젝트입니다. 사이드바에서 포커스를 이동했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Project is al open. Het is geselecteerd in de zijbalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto já está aberto. Ele foi focado na barra lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект уже открыт. Он выбран в боковой панели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจ็กต์เปิดอยู่แล้ว โฟกัสไปที่โปรเจ็กต์ในแถบด้านข้างแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje zaten açık. Kenar çubuğunda odağa alındı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự án đã mở. Đã đưa tiêu điểm đến dự án trong thanh bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目已打开，已在侧边栏中聚焦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案已開啟，已在側邊欄中聚焦。"
          }
        }
      }
    },
