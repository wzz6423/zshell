    "Homebrew did not report an installed version. Refresh and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُبلغ Homebrew عن إصدار مثبّت. حدّث وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat keine installierte Version gemeldet. Aktualisiere und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew no indicó una versión instalada. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n'a pas indiqué de version installée. Actualisez et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew tidak melaporkan versi terinstal. Segarkan dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew non ha indicato una versione installata. Aggiorna e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew からインストール済みのバージョンを取得できませんでした。更新して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew가 설치된 버전을 보고하지 않았습니다. 새로 고친 후 다시 시도하세요."
          }
        },
        "nl": {
