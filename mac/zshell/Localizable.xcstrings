    "The user can’t contain “@” or whitespace.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحتوي اسم المستخدم على «@» أو مسافات بيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
