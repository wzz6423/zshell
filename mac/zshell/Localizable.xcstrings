    "Lets agents delegate work and coordinate across Zshell panes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للوكلاء تفويض العمل والتنسيق بين لوحات Zshell"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Agenten, Aufgaben zu delegieren und sich über Zshell-Bereiche hinweg abzustimmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los agentes delegar trabajo y coordinarse entre paneles de Zshell"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux agents de déléguer des tâches et de se coordonner entre les volets Zshell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan agen mendelegasikan pekerjaan dan berkoordinasi antar panel Zshell"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente agli agenti di delegare il lavoro e coordinarsi tra i riquadri di Zshell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがZshellのペイン間で作業を委任し、連携できるようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 Zshell 분할 창 간에 작업을 위임하고 조율할 수 있도록 합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat agents werk delegeren en samenwerken tussen Zshell-panelen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que agentes deleguem trabalho e se coordenem entre painéis do Zshell"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет агентам распределять работу и координировать её между панелями Zshell"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เอเจนต์มอบหมายงานและประสานงานระหว่างบานหน้าต่าง Zshell"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracıların Zshell bölmeleri arasında iş devretmesini ve eşgüdüm sağlamasını mümkün kılar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác tử phân công và phối hợp công việc giữa các ô Zshell"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 agent 在 Zshell 窗格间分派工作并协作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 agent 在 Zshell 窗格間分派工作並協作"
          }
        }
      }
    },
    "Lets coding agents insert a new line with Shift+Enter while Enter still submits the prompt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح إدراج سطر جديد بـ Shift+Enter في وكلاء البرمجة، مع إبقاء Enter لإرسال المطالبة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Coding-Agenten einen Zeilenumbruch mit Shift+Enter, während Enter weiterhin den Prompt sendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los agentes de programación insertar una línea con Shift+Enter mientras Enter sigue enviando el prompt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux agents de développement d'insérer une nouvelle ligne avec Shift+Enter, tandis qu'Enter envoie toujours l'invite"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan baris baru dengan Shift+Enter pada agen pemrograman, sementara Enter tetap mengirim prompt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente agli agenti di programmazione di inserire una nuova riga con Shift+Enter, mentre Enter invia il prompt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enterでプロンプトを送信する動作はそのままに、コーディングエージェントでShift+Enterによる改行を挿入できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트에서 Shift+Enter로 줄을 바꾸고 Enter로 프롬프트를 전송할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat programmeeragents met Shift+Enter een nieuwe regel invoegen, terwijl Enter de prompt verstuurt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que agentes de programação insiram uma nova linha com Shift+Enter enquanto Enter continua enviando o prompt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет вставлять новую строку по Shift+Enter в агентах программирования, сохраняя отправку запроса по Enter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เอเจนต์เขียนโค้ดขึ้นบรรทัดใหม่ด้วย Shift+Enter ขณะที่ Enter ยังส่งพรอมต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlama aracılarında Shift+Enter ile yeni satır eklerken Enter ile istem göndermeyi korur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép xuống dòng bằng Shift+Enter trong tác tử lập trình, còn Enter vẫn gửi câu lệnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让编码智能体使用 Shift+Enter 插入新行，同时 Enter 仍会提交提示词"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓編碼智能體使用 Shift+Enter 插入新行，同時 Enter 仍會提交提示詞"
          }
        }
      }
    },
