    "Reconnect and take control of the remote terminal before pasting files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect and take control of the remote terminal before pasting files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴文件前，请重新连接并取得远程终端的控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上檔案前，請重新連線並取得遠端終端機的控制權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを貼り付ける前に、リモートターミナルに再接続して制御権を取得してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 붙여 넣기 전에 원격 터미널에 다시 연결하고 제어권을 가져오세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous au terminal distant et prenez-en le contrôle avant de coller des fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich erneut und übernehmen Sie die Kontrolle über das entfernte Terminal, bevor Sie Dateien einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte y toma el control del terminal remoto antes de pegar archivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte e assuma o controle do terminal remoto antes de colar arquivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti e prendi il controllo del terminale remoto prima di incollare file."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak opnieuw verbinding en neem de besturing van de externe terminal over voordat je bestanden plakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед вставкой файлов подключитесь снова и получите управление удалённым терминалом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعِد الاتصال بالطرفية البعيدة وتولَّ التحكم فيها قبل لصق الملفات."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อใหม่และรับสิทธิ์ควบคุมเทอร์มินัลระยะไกลก่อนวางไฟล์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan kembali dan ambil kendali terminal jarak jauh sebelum menempelkan berkas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối lại và giành quyền điều khiển terminal từ xa trước khi dán tệp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya yapıştırmadan önce yeniden bağlanın ve uzak terminalin kontrolünü alın."
          }
        }
      }
    },
    "Remote agent setup failed.": {
