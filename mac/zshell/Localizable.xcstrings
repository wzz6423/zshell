    "Use SSH to install or update the remote server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use SSH to install or update the remote server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 SSH 安装或更新远程服务端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 SSH 安裝或更新遠端伺服器。"
          }
        },
        "ja": {
