            "value": "%@ のワークツリーを削除しますか？Git ブランチは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 작업 트리를 제거하시겠습니까? Git 브랜치는 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree op %@ verwijderen? Git behoudt de bijbehorende branch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover a árvore de trabalho em %@? O Git manterá a branch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить рабочее дерево в %@? Git сохранит его ветку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเวิร์กทรีที่ %@ ออกหรือไม่? Git จะเก็บสาขาไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konumundaki çalışma ağacı kaldırılsın mı? Git dalını koruyacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa cây làm việc tại %@? Git sẽ giữ lại nhánh của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除位于 %@ 的工作树？Git 会保留其分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除位於 %@ 的工作樹？Git 會保留其分支。"
          }
        }
      }
    },
    "A stash snapshot including untracked files will be created before deleting %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إنشاء لقطة stash تتضمن الملفات غير المتتبعة قبل حذف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Löschen von %@ wird ein Stash-Snapshot einschließlich nicht versionierter Dateien erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stash snapshot including untracked files will be created before deleting %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de eliminar %@ se creará una instantánea stash que incluye los archivos sin seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instantané stash incluant les fichiers non suivis sera créé avant la suppression de %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot stash termasuk file yang belum dilacak akan dibuat sebelum menghapus %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di eliminare %@ verrà creata un’istantanea stash che include i file non tracciati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除する前に、未追跡ファイルを含む stash スナップショットが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제하기 전에 추적되지 않은 파일을 포함하는 stash 스냅샷이 생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat %@ wordt verwijderd, wordt een stash-snapshot gemaakt met niet-gevolgde bestanden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um snapshot stash, incluindo arquivos não rastreados, será criado antes de excluir %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед удалением %@ будет создан снимок stash, включающий неотслеживаемые файлы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะสร้างสแนปช็อต stash ที่รวมไฟล์ที่ยังไม่ได้ติดตามก่อนลบ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silinmeden önce izlenmeyen dosyaları da içeren bir stash anlık görüntüsü oluşturulacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bản chụp stash bao gồm các tệp chưa được theo dõi sẽ được tạo trước khi xóa %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@ 前，将创建包含未跟踪文件的 stash 快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %@ 前，將建立包含未追蹤檔案的 stash 快照。"
          }
        }
      }
    },
