            "value": "لا توجد لقطة لحدود الاستخدام من جلسة Claude Code نشطة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Nutzungslimit-Snapshot aus einer aktiven Claude Code-Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una instantánea del límite de uso de una sesión activa de Claude Code."
          }
