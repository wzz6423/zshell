    "Connect with the system OpenSSH client. Password prompts are disabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال بعميل OpenSSH الخاص بالنظام. مطالبات كلمة المرور معطّلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem OpenSSH-Client des Systems verbinden. Passwortabfragen sind deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar con el cliente OpenSSH del sistema. Las solicitudes de contraseña están desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter avec le client OpenSSH du système. Les invites de mot de passe sont désactivées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan dengan klien OpenSSH sistem. Permintaan kata sandi dinonaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti con il client OpenSSH di sistema. Le richieste di password sono disabilitate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのOpenSSHクライアントで接続します。パスワード入力は無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 OpenSSH 클라이언트로 연결합니다. 암호 입력 요청은 비활성화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind met de OpenSSH-client van het systeem. Wachtwoordvragen zijn uitgeschakeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte usando o cliente OpenSSH do sistema. Solicitações de senha estão desativadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение через системный клиент OpenSSH. Запросы пароля отключены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อด้วยไคลเอนต์ OpenSSH ของระบบ โดยปิดการถามรหัสผ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin OpenSSH istemcisiyle bağlanır. Parola istemleri devre dışıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối bằng máy khách OpenSSH của hệ thống. Yêu cầu nhập mật khẩu bị tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过系统 OpenSSH 客户端连接。已禁用密码提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過系統 OpenSSH 用戶端連接。已禁用密碼提示。"
          }
        }
      }
    },
