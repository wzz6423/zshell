    "Repository changed before the Git action could run. Review the current changes and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر المستودع قبل تنفيذ إجراء Git. راجع التغييرات الحالية وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository hat sich vor der Git-Aktion geändert. Prüfe die aktuellen Änderungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio cambió antes de ejecutar la acción de Git. Revisa los cambios actuales e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt a changé avant l'action Git. Examinez les modifications actuelles et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori berubah sebelum tindakan Git dijalankan. Tinjau perubahan saat ini dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository è cambiato prima dell'azione Git. Controlla le modifiche attuali e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git操作の前にリポジトリが変更されました。現在の変更を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 작업을 실행하기 전에 저장소가 변경되었습니다. 현재 변경 사항을 검토하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De repository is gewijzigd voordat de Git-actie kon worden uitgevoerd. Beoordeel de huidige wijzigingen en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório mudou antes da ação Git. Revise as alterações atuais e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий изменился до выполнения операции Git. Проверьте текущие изменения и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่เก็บเปลี่ยนก่อนดำเนินการ Git ตรวจทานการเปลี่ยนแปลงปัจจุบันแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git işlemi çalıştırılmadan önce depo değişti. Mevcut değişiklikleri inceleyip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho đã thay đổi trước khi thực hiện thao tác Git. Xem xét các thay đổi hiện tại rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行 Git 操作前，仓库已发生变化。请检查当前更改后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 Git 操作前，儲存庫已發生變化。請檢查目前變更後重試。"
          }
        }
      }
    },
    "Repository changed before the file action could run. Review the current changes and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر المستودع قبل تنفيذ إجراء الملف. راجع التغييرات الحالية وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository hat sich vor der Dateiaktion geändert. Prüfe die aktuellen Änderungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio cambió antes de ejecutar la acción sobre los archivos. Revisa los cambios actuales e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt a changé avant l'action sur les fichiers. Examinez les modifications actuelles et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori berubah sebelum tindakan file dijalankan. Tinjau perubahan saat ini dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il repository è cambiato prima dell'azione sui file. Controlla le modifiche attuali e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル操作の前にリポジトリが変更されました。現在の変更を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 작업을 실행하기 전에 저장소가 변경되었습니다. 현재 변경 사항을 검토하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De repository is gewijzigd voordat de bestandsactie kon worden uitgevoerd. Beoordeel de huidige wijzigingen en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório mudou antes da ação nos arquivos. Revise as alterações atuais e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий изменился до выполнения операции с файлом. Проверьте текущие изменения и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่เก็บเปลี่ยนก่อนดำเนินการกับไฟล์ ตรวจทานการเปลี่ยนแปลงปัจจุบันแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya işlemi çalıştırılmadan önce depo değişti. Mevcut değişiklikleri inceleyip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho đã thay đổi trước khi thực hiện thao tác tệp. Xem xét các thay đổi hiện tại rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行文件操作前，仓库已发生变化。请检查当前更改后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行檔案操作前，儲存庫已發生變化。請檢查目前變更後重試。"
          }
        }
      }
    },
    "Repository changed; refresh and try the Git action again": {
      "localizations": {
        "ar": {
          "stringUnit": {
