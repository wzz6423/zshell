    "Branch or HEAD changed before the Git action could run. Review the current changes and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الفرع أو HEAD قبل تنفيذ إجراء Git. راجع التغييرات الحالية وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch oder HEAD hat sich vor der Git-Aktion geändert. Prüfe die aktuellen Änderungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La rama o HEAD cambió antes de ejecutar la acción de Git. Revisa los cambios actuales e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche ou HEAD a changé avant l'exécution de l'action Git. Examinez les modifications actuelles et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch atau HEAD berubah sebelum tindakan Git dijalankan. Tinjau perubahan saat ini dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il branch o HEAD è cambiato prima dell'azione Git. Controlla le modifiche attuali e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git操作の前にブランチまたはHEADが変更されました。現在の変更を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 작업을 실행하기 전에 브랜치 또는 HEAD가 변경되었습니다. 현재 변경 사항을 검토하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De branch of HEAD is gewijzigd voordat de Git-actie kon worden uitgevoerd. Beoordeel de huidige wijzigingen en probeer het opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A branch ou HEAD mudou antes da ação Git. Revise as alterações atuais e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ветка или HEAD изменились до выполнения операции Git. Проверьте текущие изменения и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขาหรือ HEAD เปลี่ยนก่อนดำเนินการ Git ตรวจทานการเปลี่ยนแปลงปัจจุบันแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Git işlemi çalıştırılmadan önce dal veya HEAD değişti. Mevcut değişiklikleri inceleyip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh hoặc HEAD đã thay đổi trước khi thực hiện thao tác Git. Xem xét các thay đổi hiện tại rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行 Git 操作前，分支或 HEAD 已发生变化。请检查当前更改后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 Git 操作前，分支或 HEAD 已發生變化。請檢查目前變更後重試。"
          }
        }
      }
    },
