    "Enter the full path to an executable file. New terminals use your login shell until the path is valid.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل المسار الكامل لملف تنفيذي. تستخدم الطرفيات الجديدة صدفة تسجيل الدخول حتى يصبح المسار صالحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den vollständigen Pfad zu einer ausführbaren Datei ein. Neue Terminals verwenden deine Login-Shell, bis der Pfad gültig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la ruta completa de un archivo ejecutable. Los terminales nuevos usarán tu shell de inicio de sesión hasta que la ruta sea válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le chemin complet d'un fichier exécutable. Les nouveaux terminaux utilisent votre shell de connexion tant que le chemin n'est pas valide."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan path lengkap ke file eksekutabel. Terminal baru memakai shell login sampai path valid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il percorso completo di un file eseguibile. I nuovi terminali usano la shell di login finché il percorso non è valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行可能ファイルのフルパスを入力してください。パスが有効になるまで、新しいターミナルはログインシェルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 파일의 전체 경로를 입력하세요. 경로가 올바를 때까지 새 터미널은 로그인 셸을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het volledige pad naar een uitvoerbaar bestand in. Nieuwe terminals gebruiken je inlogshell totdat het pad geldig is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o caminho completo de um arquivo executável. Novos terminais usam seu shell de login até que o caminho seja válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите полный путь к исполняемому файлу. Пока путь некорректен, новые терминалы используют вашу оболочку входа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนพาธเต็มของไฟล์ปฏิบัติการ เทอร์มินัลใหม่จะใช้ล็อกอินเชลล์จนกว่าพาธจะถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştırılabilir dosyanın tam yolunu girin. Yol geçerli olana kadar yeni terminaller oturum açma kabuğunuzu kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập đường dẫn đầy đủ đến tệp thực thi. Terminal mới dùng shell đăng nhập cho đến khi đường dẫn hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入可执行文件的完整路径。在路径有效前，新终端将使用登录 Shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入可執行檔案的完整路徑。在路徑有效前，新終端機將使用登入 Shell。"
          }
        }
      }
    },
