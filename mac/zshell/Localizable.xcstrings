            "state": "translated",
            "value": "無法安全移除工作樹。"
          }
        }
      }
    },
    "The worktree changed before the session could start.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت شجرة العمل قبل بدء الجلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree wurde vor dem Sitzungsstart geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worktree cambió antes de que pudiera iniciarse la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree a changé avant le démarrage de la session."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree berubah sebelum sesi dapat dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree è cambiato prima dell’avvio della sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを開始する前にワークツリーが変わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 시작되기 전에 워크트리가 변경되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktree is gewijzigd voordat de sessie kon starten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worktree mudou antes de a sessão iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree изменился до запуска сеанса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวิร์กทรีเปลี่ยนไปก่อนเริ่มเซสชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum başlamadan önce worktree değişti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree đã thay đổi trước khi phiên bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话启动前工作树已改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段啟動前工作樹已變更。"
          }
        }
      }
    },
    "The worktree changed. Review it before removing it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت شجرة العمل. راجعها قبل إزالتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree hat sich geändert. Prüfen Sie ihn vor dem Entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worktree cambió. Revísalo antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree a changé. Vérifiez-le avant de le supprimer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree berubah. Tinjau sebelum menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree è cambiato. Controllalo prima di rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーが変わりました。削除する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리가 변경되었습니다. 제거하기 전에 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktree is gewijzigd. Controleer hem voordat je hem verwijdert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worktree mudou. Revise-o antes de removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree изменился. Проверьте его перед удалением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวิร์กทรีเปลี่ยนไป ตรวจสอบก่อนนำออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree değişti. Kaldırmadan önce inceleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree đã thay đổi. Hãy kiểm tra trước khi xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树已改变。请检查后再移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作樹已變更。請檢查後再移除。"
          }
        }
      }
    },
    "The worktree contains changed, untracked, or ignored files. Keep it and commit or remove those files first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي شجرة العمل على ملفات معدلة أو غير متتبعة أو متجاهلة. احتفظ بها وثبّت هذه الملفات أو أزلها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree enthält geänderte, nicht verfolgte oder ignorierte Dateien. Behalten Sie ihn und committen oder entfernen Sie diese Dateien zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worktree contiene archivos modificados, no seguidos o ignorados. Consérvalo y primero confirma o elimina esos archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree contient des fichiers modifiés, non suivis ou ignorés. Conservez-le et validez ou supprimez d’abord ces fichiers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree berisi file yang diubah, tidak dilacak, atau diabaikan. Pertahankan dan commit atau hapus file tersebut terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree contiene file modificati, non tracciati o ignorati. Mantienilo e prima crea un commit o rimuovi questi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーに変更済み、未追跡、または無視されたファイルがあります。保持して、先にこれらをコミットまたは削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리에 변경되거나 추적되지 않거나 무시된 파일이 있습니다. 워크트리를 유지하고 먼저 파일을 커밋하거나 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktree bevat gewijzigde, niet gevolgde of genegeerde bestanden. Behoud hem en commit of verwijder deze bestanden eerst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worktree contém arquivos alterados, não rastreados ou ignorados. Mantenha-o e primeiro faça commit ou remova esses arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В worktree есть изменённые, неотслеживаемые или игнорируемые файлы. Сохраните его и сначала закоммитьте или удалите эти файлы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวิร์กทรีมีไฟล์ที่แก้ไข ไม่ได้ติดตาม หรือถูกละเว้น เก็บเวิร์กทรีไว้แล้วคอมมิตหรือนำไฟล์เหล่านั้นออกก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree değiştirilmiş, izlenmeyen veya yok sayılan dosyalar içeriyor. Koruyup önce bu dosyaları commit edin veya kaldırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree có tệp đã thay đổi, chưa được theo dõi hoặc bị bỏ qua. Hãy giữ lại và commit hoặc xóa các tệp đó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树包含已改动、未跟踪或被忽略的文件。请保留工作树，先提交或移除这些文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作樹包含已變更、未追蹤或忽略的檔案。請保留工作樹，先提交或移除這些檔案。"
          }
        }
      }
    },
    "The worktree directory already exists. Choose a new directory.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلد شجرة العمل موجود بالفعل. اختر مجلدًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Worktree-Verzeichnis existiert bereits. Wählen Sie ein neues Verzeichnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio del worktree ya existe. Elige uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du worktree existe déjà. Choisissez un nouveau dossier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktori worktree sudah ada. Pilih direktori baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella del worktree esiste già. Scegli una nuova cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーのディレクトリは既に存在します。新しいディレクトリを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리 디렉터리가 이미 있습니다. 새 디렉터리를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktree-map bestaat al. Kies een nieuwe map."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório do worktree já existe. Escolha um novo diretório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог worktree уже существует. Выберите новый каталог."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดเรกทอรีเวิร์กทรีมีอยู่แล้ว เลือกไดเรกทอรีใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree dizini zaten var. Yeni bir dizin seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục worktree đã tồn tại. Hãy chọn thư mục mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树目录已存在。请选择新目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作樹目錄已存在。請選擇新目錄。"
          }
        }
      }
    },
    "The worktree has commits that are not merged into its baseline. Keep it and merge the branch first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي شجرة العمل على تثبيتات لم تُدمج في مرجعها الأساسي. احتفظ بها وادمج الفرع أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree enthält Commits, die nicht in die Basisreferenz gemergt sind. Behalten Sie ihn und mergen Sie zuerst den Zweig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worktree tiene commits que no se han fusionado en su referencia base. Consérvalo y fusiona primero la rama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree contient des commits non fusionnés dans sa référence de base. Conservez-le et fusionnez d’abord la branche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree memiliki commit yang belum digabungkan ke referensi dasarnya. Pertahankan dan gabungkan cabang terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree contiene commit non uniti al riferimento di base. Mantienilo e unisci prima il ramo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーに基準へマージされていないコミットがあります。保持して、先にブランチをマージしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리에 기준에 병합되지 않은 커밋이 있습니다. 워크트리를 유지하고 먼저 브랜치를 병합하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktree heeft commits die nog niet in de basisreferentie zijn samengevoegd. Behoud hem en voeg de tak eerst samen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worktree tem commits não mesclados na referência base. Mantenha-o e primeiro mescle a ramificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В worktree есть коммиты, не слитые с базой. Сохраните его и сначала выполните слияние ветки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวิร์กทรีมีคอมมิตที่ยังไม่ได้รวมเข้ากับข้อมูลอ้างอิงฐาน เก็บไว้และรวมสาขาก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree temel referansa birleştirilmemiş commit’ler içeriyor. Koruyup önce dalı birleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree có commit chưa hợp nhất vào mốc cơ sở. Hãy giữ lại và hợp nhất nhánh trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作树有尚未合入基准的提交。请保留工作树，先合并分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作樹有尚未合併至基準的提交。請保留工作樹，先合併分支。"
          }
        }
      }
    },
    "The worktree is being removed. Try again after cleanup finishes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالة شجرة العمل. حاول مجددًا بعد اكتمال التنظيف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree wird entfernt. Versuchen Sie es nach Abschluss erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está eliminando el worktree. Vuelve a intentarlo cuando termine la limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree est en cours de suppression. Réessayez après le nettoyage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree sedang dihapus. Coba lagi setelah pembersihan selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree è in fase di rimozione. Riprova al termine della pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーを削除しています。クリーンアップの完了後に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크트리를 제거 중입니다. 정리가 끝난 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De worktree wordt verwijderd. Probeer opnieuw nadat het opruimen is voltooid."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worktree está sendo removido. Tente novamente após a limpeza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree удаляется. Повторите попытку после завершения очистки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังนำเวิร์กทรีออก ลองอีกครั้งหลังทำความสะอาดเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree kaldırılıyor. Temizlik tamamlandıktan sonra yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree đang được xóa. Thử lại sau khi dọn dẹp xong."
          }
        },
        "zh-Hans": {
