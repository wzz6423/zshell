    "Values are saved as plain text in the session snapshot. Do not store passwords, tokens, or other secrets here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ القيم كنص عادي في لقطة الجلسة. لا تخزّن كلمات مرور أو رموز وصول أو أسرارًا أخرى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte werden im Sitzungs-Snapshot als Klartext gespeichert. Speichere hier keine Passwörter, Token oder anderen Geheimnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores se guardan como texto sin formato en la instantánea de la sesión. No guardes contraseñas, tokens ni otros secretos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont enregistrées en clair dans l'instantané de session. N'y stockez pas de mots de passe, jetons ou autres secrets."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai disimpan sebagai teks biasa dalam snapshot sesi. Jangan simpan kata sandi, token, atau rahasia lain di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori vengono salvati in chiaro nell'istantanea della sessione. Non memorizzare qui password, token o altri segreti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はセッションスナップショットにプレーンテキストで保存されます。パスワード、トークン、その他の秘密情報をここに保存しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 세션 스냅샷에 일반 텍스트로 저장됩니다. 암호, 토큰 또는 기타 비밀 정보를 저장하지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarden worden als platte tekst in de sessiemomentopname bewaard. Bewaar hier geen wachtwoorden, tokens of andere geheimen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores são salvos em texto simples no registro da sessão. Não armazene senhas, tokens ou outros segredos aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения сохраняются в снимке сеанса открытым текстом. Не храните здесь пароли, токены и другие секреты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าจะบันทึกเป็นข้อความธรรมดาในสแนปช็อตเซสชัน อย่าเก็บรหัสผ่าน โทเค็น หรือข้อมูลลับอื่นที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerler oturum anlık görüntüsünde düz metin olarak kaydedilir. Burada parola, token veya başka gizli bilgiler saklamayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị được lưu dạng văn bản thuần trong ảnh chụp phiên. Không lưu mật khẩu, token hoặc bí mật khác ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "值会以明文保存在会话快照中。请勿在此保存密码、令牌或其他机密信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "值會以明文儲存在工作階段快照中。請勿在此儲存密碼、令牌或其他機密信息。"
          }
        }
      }
    },
    "Variable names must begin with a letter or underscore and contain only letters, numbers, and underscores.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تبدأ أسماء المتغيرات بحرف أو شرطة سفلية، وأن تحتوي على أحرف وأرقام وشرطات سفلية فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Variablennamen müssen mit einem Buchstaben oder Unterstrich beginnen und dürfen nur Buchstaben, Zahlen und Unterstriche enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de variables deben empezar por una letra o un guion bajo y contener solo letras, números y guiones bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de variables doivent commencer par une lettre ou un tiret bas et ne contenir que des lettres, chiffres et tirets bas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama variabel harus diawali huruf atau garis bawah dan hanya memuat huruf, angka, serta garis bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi delle variabili devono iniziare con una lettera o un trattino basso e contenere solo lettere, numeri e trattini bassi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変数名は英字またはアンダースコアで始まり、英数字とアンダースコアのみを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변수 이름은 문자 또는 밑줄로 시작해야 하며 문자, 숫자, 밑줄만 포함할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Variabelenamen moeten beginnen met een letter of onderstrepingsteken en mogen alleen letters, cijfers en onderstrepingstekens bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes de variáveis devem começar com uma letra ou sublinhado e conter apenas letras, números e sublinhados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена переменных должны начинаться с буквы или подчёркивания и содержать только буквы, цифры и подчёркивания."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อตัวแปรต้องขึ้นต้นด้วยตัวอักษรหรือขีดล่าง และมีได้เฉพาะตัวอักษร ตัวเลข และขีดล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişken adları harf veya alt çizgiyle başlamalı, yalnızca harf, sayı ve alt çizgi içermelidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên biến phải bắt đầu bằng chữ cái hoặc dấu gạch dưới và chỉ chứa chữ cái, số, dấu gạch dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变量名必须以字母或下划线开头，并且只能包含字母、数字和下划线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變數名必須以字母或下划線開頭，並且只能包含字母、數字和下划線。"
          }
        }
      }
    },
