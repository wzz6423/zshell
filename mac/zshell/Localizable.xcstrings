    "Create or switch to a branch before publishing detached HEAD": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ فرعًا أو انتقل إلى فرع قبل نشر HEAD المنفصل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle oder wechsle zu einem Branch, bevor du einen losgelösten HEAD veröffentlichst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una rama o cambia a una antes de publicar un HEAD separado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une branche ou passez à une branche avant de publier un HEAD détaché"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat atau beralih ke branch sebelum menerbitkan HEAD terlepas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea o passa a un branch prima di pubblicare un HEAD scollegato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "detached HEADを公開する前に、ブランチを作成するか切り替えてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분리된 HEAD를 게시하기 전에 브랜치를 만들거나 전환하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een branch aan of schakel ernaar voordat je een losgekoppelde HEAD publiceert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie ou mude para uma branch antes de publicar um HEAD destacado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте ветку или переключитесь на неё перед публикацией отсоединённого HEAD"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างหรือสลับสาขาก่อนเผยแพร่ HEAD ที่แยกออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrık HEAD’i yayımlamadan önce bir dal oluşturun veya bir dala geçin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo hoặc chuyển sang một nhánh trước khi xuất bản HEAD tách rời"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布分离 HEAD 前，请先创建或切换到分支"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發佈分離 HEAD 前，請先建立或切換到分支"
          }
        }
      }
    },
