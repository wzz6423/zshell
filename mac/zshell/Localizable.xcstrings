    "Tab variables override project variables with the same name. These settings affect only terminals created later in this tab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز متغيرات التبويب متغيرات المشروع التي تحمل الاسم نفسه. تؤثر هذه الإعدادات فقط في الطرفيات المنشأة لاحقًا في هذا التبويب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabvariablen überschreiben gleichnamige Projektvariablen. Diese Einstellungen gelten nur für später in diesem Tab erstellte Terminals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables de la pestaña reemplazan a las del proyecto con el mismo nombre. Estos ajustes solo afectan a los terminales creados después en esta pestaña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables de l'onglet remplacent les variables du projet de même nom. Ces réglages ne concernent que les terminaux créés ensuite dans cet onglet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Variabel tab menimpa variabel proyek bernama sama. Pengaturan ini hanya memengaruhi terminal yang dibuat nanti di tab ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili della scheda sostituiscono quelle del progetto con lo stesso nome. Queste impostazioni riguardano solo i terminali creati in seguito in questa scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの変数は同名のプロジェクト変数を上書きします。これらの設定は、このタブで今後作成されるターミナルにのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 변수는 이름이 같은 프로젝트 변수보다 우선합니다. 이 설정은 이후 이 탭에 생성되는 터미널에만 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbladvariabelen overschrijven projectvariabelen met dezelfde naam. Deze instellingen gelden alleen voor terminals die later in dit tabblad worden aangemaakt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Variáveis da aba substituem as do projeto com o mesmo nome. Estes ajustes afetam apenas terminais criados depois nesta aba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменные вкладки переопределяют одноимённые переменные проекта. Настройки влияют только на терминалы, созданные в этой вкладке позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแปรแท็บจะแทนที่ตัวแปรโปรเจ็กต์ที่ชื่อเดียวกัน การตั้งค่านี้มีผลเฉพาะเทอร์มินัลที่สร้างในแท็บนี้ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekme değişkenleri aynı adlı proje değişkenlerini geçersiz kılar. Bu ayarlar yalnızca bu sekmede daha sonra oluşturulan terminalleri etkiler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến của thẻ ghi đè biến dự án cùng tên. Cài đặt này chỉ ảnh hưởng terminal được tạo sau trong thẻ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页变量会覆盖同名的项目变量。这些设置仅影响此标签页中之后新建的终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分頁變數會覆蓋同名的專案變數。這些設定僅影響此分頁中之後新增的終端機。"
          }
        }
      }
    },
    "Projects containing diffs can’t be moved into another project.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن نقل المشاريع التي تحتوي على عروض فروق إلى مشروع آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte mit Diffs können nicht in ein anderes Projekt verschoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos con diferencias no se pueden mover a otro proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets contenant des diffs ne peuvent pas être déplacés vers un autre projet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek yang berisi diff tidak dapat dipindahkan ke proyek lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti con differenze non possono essere spostati in un altro progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分を含むプロジェクトは別のプロジェクトに移動できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차이 보기가 있는 프로젝트는 다른 프로젝트로 이동할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projecten met diffs kunnen niet naar een ander project worden verplaatst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetos com diferenças não podem ser movidos para outro projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты со сравнениями нельзя перемещать в другой проект."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถย้ายโปรเจ็กต์ที่มีมุมมองความต่างไปยังโปรเจ็กต์อื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fark içeren projeler başka bir projeye taşınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuyển dự án chứa bản so sánh sang dự án khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含差异的项目无法移入另一个项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含差異的專案無法移入另一個專案。"
          }
        }
      }
    },
