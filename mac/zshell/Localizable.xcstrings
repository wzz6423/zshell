          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex è installato, ma il server locale dell'app non ha effettuato l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex はインストールされていますが、ローカルアプリサーバーにサインインしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex가 설치되어 있지만 로컬 앱 서버에 로그인되어 있지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex is geïnstalleerd, maar de lokale appserver is niet aangemeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex está instalado, mas seu servidor local do app não está autenticado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex установлен, но вход на локальном сервере приложения не выполнен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้ง Codex แล้ว แต่ยังไม่ได้ลงชื่อเข้าใช้เซิร์ฟเวอร์แอปในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex yüklü ancak yerel uygulama sunucusunda oturum açılmamış."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex đã được cài đặt nhưng máy chủ ứng dụng cục bộ chưa đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 已安装，但其本地应用服务器未登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 已安裝，但其本機應用伺服器未登入。"
          }
        }
      }
