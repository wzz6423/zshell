            "state": "translated",
            "value": "호스트는 “-”로 시작하거나 공백을 포함할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De host mag niet beginnen met ‘-’ en mag geen witruimte bevatten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host não pode começar com “-” nem conter espaços em branco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хост не может начинаться с «-» или содержать пробельные символы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฮสต์ต้องไม่ขึ้นต้นด้วย “-” หรือมีอักขระช่องว่าง"
          }
        },
        "tr": {
