        }
      }
    },
    "Used after the Latin family and before the bundled symbol font": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم بعد عائلة الخط اللاتيني وقبل خط الرموز المضمّن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach der lateinischen Schriftfamilie und vor der mitgelieferten Symbolschrift verwendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa después de la familia latina y antes de la fuente de símbolos incluida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée après la famille latine et avant la police de symboles intégrée"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan setelah keluarga font Latin dan sebelum font simbol bawaan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata dopo la famiglia latina e prima del font di simboli integrato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラテン文字フォントの後、同梱の記号フォントの前に使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라틴 글꼴 다음, 내장 기호 글꼴 전에 사용합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt na de Latijnse lettertypefamilie en vóór het meegeleverde symboollettertype"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usada após a família latina e antes da fonte de símbolos incluída"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется после латинского семейства и перед встроенным шрифтом символов"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้หลังตระกูลฟอนต์ละตินและก่อนฟอนต์สัญลักษณ์ที่มาพร้อมแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Latin yazı tipi ailesinden sonra, yerleşik sembol yazı tipinden önce kullanılır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng sau họ phông Latin và trước phông ký hiệu tích hợp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于拉丁字体之后、内置符号字体之前"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於拉丁字體之後、內建符號字體之前"
          }
        }
