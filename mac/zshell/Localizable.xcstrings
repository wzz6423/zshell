    "Renders terminal text with slightly heavier strokes, like classic macOS font smoothing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض نص الطرفية بخطوط أثقل قليلًا، مثل تنعيم الخطوط التقليدي في macOS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Terminaltext mit etwas kräftigeren Strichen, ähnlich der klassischen macOS-Schriftglättung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza el texto del terminal con trazos algo más gruesos, como el suavizado de fuentes clásico de macOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le texte du terminal avec des traits légèrement plus épais, comme le lissage classique des polices macOS"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merender teks terminal dengan goresan sedikit lebih tebal, seperti penghalusan font klasik macOS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il testo del terminale con tratti leggermente più spessi, come la classica levigatura dei font di macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラシックなmacOSのフォントスムージングのように、ターミナルの文字を少し太い線で描画します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 macOS 글꼴 다듬기처럼 터미널 텍스트의 획을 약간 굵게 표시합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeft terminaltekst met iets dikkere lijnen weer, zoals de klassieke lettertypevereffening van macOS"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza o texto do terminal com traços um pouco mais grossos, como a suavização de fontes clássica do macOS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает текст терминала чуть более толстыми штрихами, как классическое сглаживание шрифтов macOS"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงข้อความเทอร์มินัลด้วยเส้นหนาขึ้นเล็กน้อย คล้ายการเกลี่ยขอบฟอนต์แบบดั้งเดิมของ macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal metnini klasik macOS yazı tipi yumuşatması gibi biraz daha kalın çizgilerle görüntüler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị văn bản terminal với nét hơi dày hơn, giống làm mịn phông cổ điển của macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以稍粗的笔画渲染终端文字，效果类似经典 macOS 字体平滑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以稍粗的筆畫渲染終端機文字，效果類似經典 macOS 字體平滑"
          }
        }
      }
    },
