    "A name can’t contain “/” or be “.” or “..”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحتوي الاسم على «/» أو أن يكون «.» أو «..»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name darf weder „/“ enthalten noch „.“ oder „..“ sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre no puede contener «/» ni ser «.» o «..»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom ne peut pas contenir « / » ni être « . » ou « .. »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama tidak boleh mengandung “/” atau berupa “.” maupun “..”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome non può contenere «/» né essere «.» o «..»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に「/」は使えません。また「.」や「..」にはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름에 “/”를 포함하거나 “.” 또는 “..”를 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam mag geen ‘/’ bevatten en mag niet ‘.’ of ‘..’ zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome não pode conter “/” nem ser “.” ou “..”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может содержать «/» или быть «.» либо «..»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อต้องไม่มี “/” และต้องไม่เป็น “.” หรือ “..”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad “/” içeremez, “.” veya “..” olamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên không được chứa “/” hoặc là “.” hay “..”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称不能包含“/”，也不能是“.”或“..”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱不能包含“/”，也不能是“.”或“..”。"
          }
        }
      }
    },
