        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya işlemi çalıştırılmadan önce dal veya HEAD değişti. Mevcut değişiklikleri inceleyip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh hoặc HEAD đã thay đổi trước khi thực hiện thao tác tệp. Xem xét các thay đổi hiện tại rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行文件操作前，分支或 HEAD 已发生变化。请检查当前更改后重试。"
