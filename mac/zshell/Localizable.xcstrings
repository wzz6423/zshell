    "Tools are downloaded, installed, and updated through your Homebrew installation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل الأدوات وتُثبَّت وتُحدَّث عبر تثبيت Homebrew لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkzeuge werden über deine Homebrew-Installation geladen, installiert und aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas se descargan, instalan y actualizan mediante tu instalación de Homebrew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils sont téléchargés, installés et mis à jour via votre installation Homebrew."
          }
