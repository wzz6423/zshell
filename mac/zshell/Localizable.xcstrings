        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario no puede contener «@» ni espacios en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d'utilisateur ne peut pas contenir « @ » ni d'espaces."
          }
