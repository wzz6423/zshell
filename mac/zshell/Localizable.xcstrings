          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ được tải, cài và cập nhật qua Homebrew đã cài trên máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过本机 Homebrew 下载、安装和更新工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過本機 Homebrew 下載、安裝和更新工具。"
