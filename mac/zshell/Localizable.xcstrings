    "New branches start from the selected baseline. Choose a directory that does not exist yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الفروع الجديدة من المرجع المحدد. اختر مجلدًا غير موجود بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Zweige beginnen an der gewählten Basisreferenz. Wählen Sie ein noch nicht vorhandenes Verzeichnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas ramas parten de la referencia elegida. Elige un directorio que aún no exista."
          }
        },
        "fr": {
