            "value": "حُفظت التعديلات المتزامنة في %@. افحصها قبل إعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichzeitige Änderungen wurden unter %@ gesichert. Prüfen Sie diese vor einem erneuten Versuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concurrent edits were preserved at %@. Inspect them before retrying."
          }
        },
        "es": {
