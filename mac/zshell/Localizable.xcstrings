    "Install a Homebrew-managed copy. Your existing installation may take precedence in PATH.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تثبيت نسخة يديرها Homebrew. قد تكون لتثبيتك الحالي أولوية في PATH."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere eine von Homebrew verwaltete Kopie. Deine bestehende Installation hat möglicherweise Vorrang im PATH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala una copia gestionada por Homebrew. Tu instalación existente puede tener prioridad en PATH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez une copie gérée par Homebrew. Votre installation actuelle peut rester prioritaire dans PATH."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal salinan yang dikelola Homebrew. Instalasi yang sudah ada mungkin lebih diutamakan di PATH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa una copia gestita da Homebrew. L'installazione esistente potrebbe avere la precedenza nel PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew で管理するコピーをインストールします。PATH の順序によっては既存のインストールが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew에서 관리하는 복사본을 설치합니다. 기존 설치가 PATH에서 우선할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer een door Homebrew beheerde kopie. Je bestaande installatie kan voorrang hebben in PATH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale uma cópia gerenciada pelo Homebrew. Sua instalação existente pode ter precedência no PATH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить копию под управлением Homebrew. Существующая установка может иметь приоритет в PATH."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งสำเนาที่ Homebrew จัดการ การติดตั้งเดิมอาจมีลำดับสูงกว่าใน PATH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew tarafından yönetilen bir kopya yükleyin. Mevcut kurulumunuz PATH içinde öncelikli olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài bản do Homebrew quản lý. Bản cài hiện tại có thể được ưu tiên trong PATH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装由 Homebrew 管理的版本。现有安装可能在 PATH 中具有更高优先级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝由 Homebrew 管理的版本。現有安裝可能在 PATH 中具有更高優先級。"
          }
        }
      }
    },
