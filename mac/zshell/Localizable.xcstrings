    "Only folders can be added as projects.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إضافة المجلدات فقط كمشاريع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ordner können als Projekte hinzugefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden añadir carpetas como proyectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les dossiers peuvent être ajoutés comme projets."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya folder yang dapat ditambahkan sebagai proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le cartelle possono essere aggiunte come progetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトとして追加できるのはフォルダだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더만 프로젝트로 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen mappen kunnen als projecten worden toegevoegd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas pastas podem ser adicionadas como projetos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В качестве проектов можно добавлять только папки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเป็นโปรเจ็กต์ได้เฉพาะโฟลเดอร์เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca klasörler proje olarak eklenebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể thêm thư mục làm dự án."
          }
