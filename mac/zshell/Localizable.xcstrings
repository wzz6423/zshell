            "value": "O tempo limite deve estar entre 0 e 86400000 milissegundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il timeout deve essere compreso tra 0 e 86400000 millisecondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachttijd moet tussen 0 en 86400000 milliseconden liggen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
