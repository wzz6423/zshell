    "Paste regular files up to 32 MiB each. Folders and symbolic links aren’t supported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste regular files up to 32 MiB each. Folders and symbolic links aren’t supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可粘贴每个不超过 32 MiB 的常规文件。不支持文件夹和符号链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可貼上每個不超過 32 MiB 的一般檔案。不支援資料夾和符號連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ファイルあたり 32 MiB 以下の通常のファイルを貼り付けてください。フォルダとシンボリックリンクは非対応です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일당 최대 32 MiB의 일반 파일을 붙여 넣으세요. 폴더와 심볼릭 링크는 지원되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez des fichiers ordinaires de 32 MiB maximum chacun. Les dossiers et les liens symboliques ne sont pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie reguläre Dateien mit jeweils höchstens 32 MiB ein. Ordner und symbolische Links werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega archivos normales de hasta 32 MiB cada uno. No se admiten carpetas ni enlaces simbólicos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole arquivos comuns de até 32 MiB cada. Pastas e links simbólicos não são compatíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla file normali fino a 32 MiB ciascuno. Cartelle e collegamenti simbolici non sono supportati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak gewone bestanden van maximaal 32 MiB per bestand. Mappen en symbolische koppelingen worden niet ondersteund."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставляйте обычные файлы размером до 32 MiB каждый. Папки и символические ссылки не поддерживаются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق ملفات عادية لا يتجاوز حجم كل منها 32 MiB. المجلدات والروابط الرمزية غير مدعومة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางไฟล์ปกติที่มีขนาดไม่เกิน 32 MiB ต่อไฟล์ ไม่รองรับโฟลเดอร์และลิงก์สัญลักษณ์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel berkas biasa hingga 32 MiB per berkas. Folder dan tautan simbolis tidak didukung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán các tệp thông thường có kích thước tối đa 32 MiB mỗi tệp. Không hỗ trợ thư mục và liên kết tượng trưng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri en fazla 32 MiB olan normal dosyaları yapıştırın. Klasörler ve sembolik bağlantılar desteklenmez."
          }
        }
      }
    },
    "Paste up to 32 files, with a maximum of 32 MiB per file and 64 MiB in total.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste up to 32 files, with a maximum of 32 MiB per file and 64 MiB in total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多粘贴 32 个文件，每个文件不超过 32 MiB，总大小不超过 64 MiB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多貼上 32 個檔案，每個檔案不超過 32 MiB，總大小不超過 64 MiB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大 32 個のファイルを貼り付けられます。各ファイルは 32 MiB 以下、合計は 64 MiB 以下です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 32개 파일을 붙여 넣을 수 있습니다. 파일당 최대 32 MiB, 전체 최대 64 MiB입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez jusqu’à 32 fichiers, avec un maximum de 32 MiB par fichier et de 64 MiB au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie bis zu 32 Dateien ein, mit höchstens 32 MiB pro Datei und insgesamt 64 MiB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega hasta 32 archivos, con un máximo de 32 MiB por archivo y 64 MiB en total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole até 32 arquivos, com no máximo 32 MiB por arquivo e 64 MiB no total."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla fino a 32 file, con un massimo di 32 MiB per file e 64 MiB in totale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak maximaal 32 bestanden, met maximaal 32 MiB per bestand en 64 MiB in totaal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте до 32 файлов: не более 32 MiB на файл и 64 MiB в сумме."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق حتى 32 ملفًا، بحد أقصى 32 MiB لكل ملف و64 MiB إجمالًا."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางได้สูงสุด 32 ไฟล์ โดยแต่ละไฟล์ไม่เกิน 32 MiB และรวมไม่เกิน 64 MiB"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel hingga 32 berkas, dengan maksimum 32 MiB per berkas dan total 64 MiB."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán tối đa 32 tệp, mỗi tệp không quá 32 MiB và tổng cộng không quá 64 MiB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 32 dosya yapıştırın; dosya başına en çok 32 MiB, toplamda en çok 64 MiB."
          }
        }
      }
    },
