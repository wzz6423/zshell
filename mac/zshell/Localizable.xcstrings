    "Could not resume the recorded agent conversation. Opening a new shell.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume the recorded agent conversation. Opening a new shell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复已记录的 Agent 对话。正在打开新 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
