    "The provider’s conversation files are kept. You can still resume the conversation using the provider’s CLI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفات المحادثة الخاصة بالمزوّد محفوظة. لا يزال بإمكانك استئناف المحادثة باستخدام واجهة سطر الأوامر الخاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterhaltungsdateien des Anbieters bleiben erhalten. Sie können die Unterhaltung weiterhin über dessen CLI fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider’s conversation files are kept. You can still resume the conversation using the provider’s CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan los archivos de conversación del proveedor. Puedes seguir reanudando la conversación con su CLI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de conversation du fournisseur sont conservés. Vous pouvez toujours reprendre la conversation avec sa CLI."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File percakapan penyedia tetap disimpan. Anda masih dapat melanjutkan percakapan melalui CLI penyedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file della conversazione del fornitore vengono conservati. Puoi ancora riprenderla tramite la sua CLI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダの会話ファイルは保持されます。プロバイダの CLI で会話を再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자의 대화 파일은 유지됩니다. 제공자의 CLI로 대화를 계속 재개할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gespreksbestanden van de aanbieder blijven bewaard. U kunt het gesprek nog steeds hervatten via diens CLI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de conversa do provedor são mantidos. Você ainda pode retomar a conversa pela CLI dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы диалога у провайдера сохранятся. Его CLI по-прежнему позволяет продолжить диалог."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
