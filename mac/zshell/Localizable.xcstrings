    "Bare repositories cannot start worktree sessions. Open a normal checkout first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للمستودعات المجردة بدء جلسات شجرة عمل. افتح نسخة عمل عادية أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare-Repositories können keine Worktree-Sitzungen starten. Öffnen Sie zuerst einen normalen Checkout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los repositorios bare no pueden iniciar sesiones de worktree. Abre primero un checkout normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dépôt nu ne peut pas ouvrir de session de worktree. Ouvrez d’abord un checkout normal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori bare tidak dapat memulai sesi worktree. Buka checkout biasa terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I repository bare non possono avviare sessioni worktree. Apri prima un checkout normale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベアリポジトリではワークツリーセッションを開始できません。通常のチェックアウトを先に開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "베어 저장소에서는 워크트리 세션을 시작할 수 없습니다. 먼저 일반 체크아웃을 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare-repository’s kunnen geen worktree-sessies starten. Open eerst een normale checkout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositórios bare não podem iniciar sessões de worktree. Abra primeiro um checkout normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голые репозитории не поддерживают сеансы worktree. Сначала откройте обычную рабочую копию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่เก็บแบบ bare ไม่สามารถเริ่มเซสชันเวิร์กทรีได้ เปิดเช็กเอาต์ปกติก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare depolar worktree oturumu başlatamaz. Önce normal bir checkout açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho bare không thể bắt đầu phiên worktree. Hãy mở bản checkout thông thường trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裸仓库无法启动工作树会话。请先打开普通检出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裸儲存庫無法啟動工作樹工作階段。請先開啟一般簽出。"
