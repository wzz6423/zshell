          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aliran peristiwa tertinggal. Berlangganan kembali untuk melanjutkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng sự kiện bị chậm. Hãy đăng ký lại để tiếp tục."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olay akışı geride kaldı. Devam etmek için yeniden abone olun."
          }
        }
      }
    },
    "Event filters require a pane UUID and known event names.": {
