    "Applies to future page requests in every browser pane. Reload open pages after changing rules.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to future page requests in every browser pane. Reload open pages after changing rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有浏览器窗格的后续页面请求生效。更改规则后请重新加载已打开的页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用至所有瀏覽器窗格的後續頁面請求。變更規則後請重新載入已開啟的頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのブラウザペインの今後のリクエストに適用されます。変更後はページを再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 브라우저 창의 이후 요청에 적용됩니다. 규칙 변경 후 열린 페이지를 새로고침하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux prochaines requêtes de tous les volets. Rechargez les pages après modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für künftige Anfragen aller Browserbereiche. Nach Änderungen offene Seiten neu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a futuras solicitudes de todos los paneles. Recarga las páginas tras cambiar las reglas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
