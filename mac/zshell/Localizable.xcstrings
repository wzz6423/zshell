    "The server executable has an incompatible platform, architecture, version, or protocol.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server executable has an incompatible platform, architecture, version, or protocol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端可执行文件的平台、架构、版本或协议不兼容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器執行檔的平台、架構、版本或通訊協定不相容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー実行ファイルのプラットフォーム、アーキテクチャ、バージョン、またはプロトコルに互換性がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 실행 파일의 플랫폼, 아키텍처, 버전 또는 프로토콜이 호환되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plateforme, l’architecture, la version ou le protocole de l’exécutable du serveur est incompatible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plattform, Architektur, Version oder Protokoll der ausführbaren Serverdatei ist nicht kompatibel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plataforma, arquitectura, versión o protocolo del ejecutable del servidor no es compatible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A plataforma, arquitetura, versão ou protocolo do executável do servidor não é compatível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La piattaforma, l’architettura, la versione o il protocollo dell’eseguibile server non è compatibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het platform, de architectuur, versie of het protocol van het uitvoerbare serverbestand is niet compatibel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платформа, архитектура, версия или протокол исполняемого файла сервера несовместимы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النظام الأساسي أو البنية أو الإصدار أو البروتوكول لملف الخادم التنفيذي غير متوافق."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพลตฟอร์ม สถาปัตยกรรม เวอร์ชัน หรือโปรโตคอลของไฟล์เซิร์ฟเวอร์ที่เรียกใช้ได้ไม่เข้ากัน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
