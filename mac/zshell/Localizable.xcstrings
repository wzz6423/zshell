    "Uses your account login shell with its login startup files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم صدفة تسجيل الدخول لحسابك وملفات بدء تسجيل الدخول الخاصة بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Login-Shell deines Kontos mit deren Login-Startdateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el shell de inicio de sesión de tu cuenta con sus archivos de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le shell de connexion de votre compte avec ses fichiers de démarrage de connexion."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai shell login akun Anda beserta file startup loginnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la shell di login dell'account con i relativi file di avvio del login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのログインシェルを、ログイン時の起動ファイルとともに使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정의 로그인 셸과 해당 로그인 시작 파일을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt de inlogshell van je account met de bijbehorende opstartbestanden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o shell de login da sua conta com seus arquivos de inicialização de login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует оболочку входа вашей учётной записи с её файлами запуска."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
