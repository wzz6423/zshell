    "The worktree cannot be removed safely.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إزالة شجرة العمل بأمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worktree kann nicht sicher entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar el worktree de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worktree ne peut pas être supprimé en toute sécurité."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree tidak dapat dihapus dengan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worktree non può essere rimosso in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークツリーを安全に削除できません。"
          }
