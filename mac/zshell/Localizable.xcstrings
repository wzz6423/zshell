    "Changes apply only to new terminals. Open shells keep their current backend.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق التغييرات على الطرفيات الجديدة فقط. تحتفظ الصدف المفتوحة بمحركها الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten nur für neue Terminals. Offene Shells behalten ihr aktuelles Backend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios solo se aplican a terminales nuevos. Los shells abiertos mantienen su motor actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements ne s'appliquent qu'aux nouveaux terminaux. Les shells ouverts conservent leur moteur actuel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan hanya berlaku untuk terminal baru. Shell yang terbuka tetap memakai backend saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano solo ai nuovi terminali. Le shell aperte mantengono il motore attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は新しく開くターミナルにのみ適用されます。すでに開いているシェルは現在のエンジンを使い続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 새 터미널에만 적용됩니다. 열려 있는 셸은 현재 백엔드를 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen gelden alleen voor nieuwe terminals. Open shells behouden hun huidige backend."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações se aplicam apenas a novos terminais. Shells abertos mantêm o backend atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения применяются только к новым терминалам. Открытые оболочки сохраняют текущий бэкенд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงมีผลเฉพาะเทอร์มินัลใหม่ เชลล์ที่เปิดอยู่จะใช้แบ็กเอนด์เดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler yalnızca yeni terminallere uygulanır. Açık kabuklar mevcut arka ucu kullanmayı sürdürür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi chỉ áp dụng cho terminal mới. Shell đang mở giữ nguyên bộ xử lý nền hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换仅对新建终端生效，已打开的 Shell 继续使用原来的渲染引擎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換僅對新增終端機生效，已開啟的 Shell 繼續使用原來的渲染引擎。"
          }
        }
      }
    },
    "Changes apply only to new terminals. Open terminals keep their current process.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق التغييرات على الطرفيات الجديدة فقط. تحتفظ الطرفيات المفتوحة بعملياتها الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten nur für neue Terminals. Offene Terminals behalten ihren aktuellen Prozess."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios solo se aplican a terminales nuevos. Los terminales abiertos mantienen su proceso actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements ne s'appliquent qu'aux nouveaux terminaux. Les terminaux ouverts conservent leur processus actuel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan hanya berlaku untuk terminal baru. Terminal yang terbuka mempertahankan proses saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano solo ai nuovi terminali. I terminali aperti mantengono il processo attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は新しいターミナルにのみ適用されます。開いているターミナルは現在のプロセスを維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 새 터미널에만 적용됩니다. 열려 있는 터미널은 현재 프로세스를 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen gelden alleen voor nieuwe terminals. Open terminals behouden hun huidige proces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações se aplicam apenas a novos terminais. Terminais abertos mantêm o processo atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения применяются только к новым терминалам. Открытые терминалы сохраняют текущий процесс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนแปลงมีผลเฉพาะเทอร์มินัลใหม่ เทอร์มินัลที่เปิดอยู่จะใช้โปรเซสเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler yalnızca yeni terminallere uygulanır. Açık terminaller mevcut işlemlerini korur."
          }
        },
        "vi": {
