    "Lets agents delegate work and coordinate across Zshell panes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح للوكلاء تفويض العمل والتنسيق بين لوحات Zshell"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Agenten, Aufgaben zu delegieren und sich über Zshell-Bereiche hinweg abzustimmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a los agentes delegar trabajo y coordinarse entre paneles de Zshell"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux agents de déléguer des tâches et de se coordonner entre les volets Zshell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan agen mendelegasikan pekerjaan dan berkoordinasi antar panel Zshell"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente agli agenti di delegare il lavoro e coordinarsi tra i riquadri di Zshell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがZshellのペイン間で作業を委任し、連携できるようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 Zshell 분할 창 간에 작업을 위임하고 조율할 수 있도록 합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat agents werk delegeren en samenwerken tussen Zshell-panelen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que agentes deleguem trabalho e se coordenem entre painéis do Zshell"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет агентам распределять работу и координировать её между панелями Zshell"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เอเจนต์มอบหมายงานและประสานงานระหว่างบานหน้าต่าง Zshell"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracıların Zshell bölmeleri arasında iş devretmesini ve eşgüdüm sağlamasını mümkün kılar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tác tử phân công và phối hợp công việc giữa các ô Zshell"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 agent 在 Zshell 窗格间分派工作并协作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 agent 在 Zshell 窗格間分派工作並協作"
          }
        }
      }
    },
    "Lets coding agents insert a new line with Shift+Enter while Enter still submits the prompt": {
      "localizations": {
