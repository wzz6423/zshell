    "Conversations appear after a supported agent reports its session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر المحادثات بعد أن يُبلغ وكيل مدعوم عن جلسته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen erscheinen, sobald ein unterstützter Agent seine Sitzung meldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations appear after a supported agent reports its session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones aparecen cuando un agente compatible informa de su sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations apparaissent lorsqu’un agent compatible signale sa session."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan muncul setelah agen yang didukung melaporkan sesinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conversazioni compaiono quando un agente supportato segnala la propria sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応エージェントがセッションを報告すると、会話がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 에이전트가 세션을 보고하면 여기에 대화가 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprekken verschijnen zodra een ondersteunde agent zijn sessie meldt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas aparecem quando um agente compatível informa sua sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалоги появятся, когда поддерживаемый агент сообщит о своём сеансе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนทนาจะปรากฏเมื่อเอเจนต์ที่รองรับรายงานเซสชันของตน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir ajan oturumunu bildirdiğinde konuşmalar burada görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hội thoại xuất hiện sau khi tác nhân được hỗ trợ báo cáo phiên của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的 Agent 报告会话后，对话会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援的 Agent 回報工作階段後，對話會顯示在這裡。"
