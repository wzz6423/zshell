    "Existing branches keep their current commit. Choose a directory that does not exist yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ الفروع الموجودة بالتثبيت الحالي. اختر مجلدًا غير موجود بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Zweige behalten ihren aktuellen Commit. Wählen Sie ein noch nicht vorhandenes Verzeichnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ramas existentes conservan su commit actual. Elige un directorio que aún no exista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les branches existantes conservent leur commit actuel. Choisissez un dossier qui n’existe pas encore."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabang yang ada mempertahankan commit saat ini. Pilih direktori yang belum ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I rami esistenti mantengono il commit corrente. Scegli una cartella che non esiste ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のブランチは現在のコミットを保持します。まだ存在しないディレクトリを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 브랜치는 현재 커밋을 유지합니다. 아직 없는 디렉터리를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande takken behouden hun huidige commit. Kies een map die nog niet bestaat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ramificações existentes mantêm seu commit atual. Escolha um diretório que ainda não exista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие ветки сохраняют текущий коммит. Выберите ещё не существующий каталог."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขาที่มีอยู่คงคอมมิตปัจจุบันไว้ เลือกไดเรกทอรีที่ยังไม่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut dallar geçerli commit’lerini korur. Henüz var olmayan bir dizin seçin."
          }
        },
        "vi": {
