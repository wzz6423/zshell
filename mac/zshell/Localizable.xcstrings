    "Codex is installed, but its local app server is not signed in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex مثبّت، لكن لم يُسجَّل الدخول إلى خادم التطبيق المحلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex ist installiert, aber sein lokaler App-Server ist nicht angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex está instalado, pero su servidor local de la app no ha iniciado sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex est installé, mais son serveur d'app local n'est pas connecté à un compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex terinstal, tetapi server aplikasi lokalnya belum masuk akun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex è installato, ma il server locale dell'app non ha effettuato l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex はインストールされていますが、ローカルアプリサーバーにサインインしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex가 설치되어 있지만 로컬 앱 서버에 로그인되어 있지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex is geïnstalleerd, maar de lokale appserver is niet aangemeld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codex está instalado, mas seu servidor local do app não está autenticado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex установлен, но вход на локальном сервере приложения не выполнен."
          }
        },
        "th": {
