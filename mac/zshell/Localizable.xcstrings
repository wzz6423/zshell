    "Zshell already has 64 pending or running command tasks. Wait for one to finish before starting another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell already has 64 pending or running command tasks. Wait for one to finish before starting another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
