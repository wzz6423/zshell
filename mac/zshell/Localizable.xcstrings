    "Review snapshot exceeded its size or time limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت لقطة المراجعة حد الحجم أو الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prüfschnappschuss hat das Größen- oder Zeitlimit überschritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review snapshot exceeded its size or time limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea de revisión superó el límite de tamaño o tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’instantané de révision a dépassé la limite de taille ou de temps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot tinjauan melampaui batas ukuran atau waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’istantanea di revisione ha superato il limite di dimensione o tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビュースナップショットがサイズまたは時間の上限を超えました。"
