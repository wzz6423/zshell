        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สาขาหรือ HEAD เปลี่ยนก่อนดำเนินการกับไฟล์ ตรวจทานการเปลี่ยนแปลงปัจจุบันแล้วลองอีกครั้ง"
          }
