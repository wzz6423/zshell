        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enterでプロンプトを送信する動作はそのままに、コーディングエージェントでShift+Enterによる改行を挿入できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트에서 Shift+Enter로 줄을 바꾸고 Enter로 프롬프트를 전송할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat programmeeragents met Shift+Enter een nieuwe regel invoegen, terwijl Enter de prompt verstuurt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que agentes de programação insiram uma nova linha com Shift+Enter enquanto Enter continua enviando o prompt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет вставлять новую строку по Shift+Enter в агентах программирования, сохраняя отправку запроса по Enter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เอเจนต์เขียนโค้ดขึ้นบรรทัดใหม่ด้วย Shift+Enter ขณะที่ Enter ยังส่งพรอมต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodlama aracılarında Shift+Enter ile yeni satır eklerken Enter ile istem göndermeyi korur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép xuống dòng bằng Shift+Enter trong tác tử lập trình, còn Enter vẫn gửi câu lệnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让编码智能体使用 Shift+Enter 插入新行，同时 Enter 仍会提交提示词"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓編碼智能體使用 Shift+Enter 插入新行，同時 Enter 仍會提交提示詞"
          }
        }
      }
    },
