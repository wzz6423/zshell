    "Versions are checked automatically while this page is open. Installations and updates start only when you click a button.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص الإصدارات تلقائيًا أثناء فتح هذه الصفحة. لا يبدأ التثبيت والتحديث إلا عند النقر على زر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionen werden automatisch geprüft, solange diese Seite geöffnet ist. Installationen und Updates starten erst nach einem Klick auf eine Schaltfläche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones se comprueban automáticamente mientras esta página está abierta. Las instalaciones y actualizaciones solo empiezan al pulsar un botón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions sont vérifiées automatiquement tant que cette page est ouverte. Les installations et mises à jour ne démarrent que lorsque vous cliquez sur un bouton."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi diperiksa otomatis selama halaman ini terbuka. Instalasi dan pembaruan hanya dimulai saat Anda mengeklik tombol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le versioni vengono verificate automaticamente mentre questa pagina è aperta. Installazioni e aggiornamenti iniziano solo quando fai clic su un pulsante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを開いている間、バージョンを自動確認します。インストールとアップデートはボタンをクリックしたときにのみ開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지가 열려 있는 동안 버전을 자동으로 확인합니다. 설치 및 업데이트는 버튼을 클릭할 때만 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versies worden automatisch gecontroleerd zolang deze pagina open is. Installaties en updates beginnen alleen wanneer je op een knop klikt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões são verificadas automaticamente enquanto esta página está aberta. Instalações e atualizações só começam quando você clica em um botão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версии проверяются автоматически, пока эта страница открыта. Установка и обновление запускаются только нажатием кнопки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบเวอร์ชันอัตโนมัติขณะเปิดหน้านี้ การติดตั้งและอัปเดตจะเริ่มเมื่อคุณคลิกปุ่มเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sayfa açıkken sürümler otomatik denetlenir. Yükleme ve güncellemeler yalnızca düğmeye tıkladığınızda başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản được kiểm tra tự động khi trang này mở. Cài đặt và cập nhật chỉ bắt đầu khi bạn nhấp nút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开此页面时自动检查版本。点击按钮后才会开始安装或更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟此頁面時自動檢查版本。點擊按鈕後才會開始安裝或更新。"
          }
        }
      }
    },
