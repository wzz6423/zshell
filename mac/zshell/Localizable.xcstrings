    "Codex is installed, but its local app server is not signed in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex مثبّت، لكن لم يُسجَّل الدخول إلى خادم التطبيق المحلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex ist installiert, aber sein lokaler App-Server ist nicht angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex está instalado, pero su servidor local de la app no ha iniciado sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex est installé, mais son serveur d'app local n'est pas connecté à un compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
