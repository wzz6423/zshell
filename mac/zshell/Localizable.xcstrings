            "value": "Aún no hay proyectos guardados. Haz clic en Nuevo para añadir uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet enregistré. Cliquez sur Nouveau pour en ajouter un."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada proyek tersimpan. Klik Baru untuk menambahkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun progetto salvato. Fai clic su Nuovo per aggiungerne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたプロジェクトはまだありません。「新規」をクリックして追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 프로젝트가 없습니다. 새로 만들기를 클릭하여 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen bewaarde projecten. Klik op Nieuw om er een toe te voegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há projetos salvos. Clique em Novo para adicionar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённых проектов пока нет. Нажмите «Новый», чтобы добавить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีโปรเจ็กต์ที่บันทึกไว้ คลิกใหม่เพื่อเพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıtlı proje yok. Eklemek için Yeni’ye tıklayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dự án đã lưu. Nhấp Mới để thêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无保存的项目。点击“新建”以添加项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無儲存的專案。點擊“新增”以加入專案。"
          }
        }
      }
    },
    "No themes match “%@”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد سمات تطابق «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Designs entsprechen „%@“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún tema coincide con «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun thème ne correspond à « %@ »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tema yang cocok dengan “%@”."
          }
        },
        "it": {
