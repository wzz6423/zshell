    "Timed out waiting for the command. The task can be waited on again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out waiting for the command. The task can be waited on again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待命令超时。可以再次等待此任务。"
