          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ramificação padrão foi encontrada. Escolha HEAD atual ou uma referência explícita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ветка по умолчанию не найдена. Выберите текущий HEAD или укажите базу явно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบสาขาเริ่มต้น เลือก HEAD ปัจจุบันหรือระบุข้อมูลอ้างอิงฐาน"
          }
        },
        "tr": {
          "stringUnit": {
