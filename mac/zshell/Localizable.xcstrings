          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy nhánh mặc định. Chọn HEAD hiện tại hoặc chỉ định mốc cơ sở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到默认分支。请选择当前 HEAD 或明确指定基准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到預設分支。請選擇目前 HEAD 或明確指定基準。"
          }
        }
      }
    },
    "Other open sessions still use this worktree. Close them before removing it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت جلسات مفتوحة أخرى تستخدم شجرة العمل هذه. أغلقها قبل إزالتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere offene Sitzungen verwenden diesen Worktree. Schließen Sie sie vor dem Entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras sesiones abiertas siguen usando este worktree. Ciérralas antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres sessions ouvertes utilisent ce worktree. Fermez-les avant de le supprimer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi lain yang terbuka masih menggunakan worktree ini. Tutup sebelum menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre sessioni aperte usano ancora questo worktree. Chiudile prima di rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の開いているセッションがこのワークツリーを使用しています。削除する前にそれらを閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 열린 세션이 이 워크트리를 사용 중입니다. 제거하기 전에 해당 세션을 닫으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere geopende sessies gebruiken deze worktree nog. Sluit ze voordat je hem verwijdert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras sessões abertas ainda usam este worktree. Feche-as antes de removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот worktree используется другими открытыми сеансами. Закройте их перед удалением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันอื่นที่เปิดอยู่ยังใช้เวิร์กทรีนี้ ปิดเซสชันเหล่านั้นก่อนนำออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer açık oturumlar bu worktree’yi kullanıyor. Kaldırmadan önce onları kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên đang mở khác vẫn dùng worktree này. Hãy đóng chúng trước khi xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已打开的会话仍在使用此工作树。请先关闭它们再移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已開啟的工作階段仍在使用此工作樹。請先關閉它們再移除。"
          }
        }
      }
    },
    "Repository HEAD changed. Review the baseline and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر HEAD المستودع. راجع المرجع الأساسي وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Repository-HEAD hat sich geändert. Prüfen Sie die Basisreferenz und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El HEAD del repositorio cambió. Revisa la referencia base y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le HEAD du dépôt a changé. Vérifiez la référence de base et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HEAD repositori berubah. Tinjau referensi dasar lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’HEAD del repository è cambiato. Controlla il riferimento di base e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリの HEAD が変わりました。基準を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 HEAD가 변경되었습니다. 기준을 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De HEAD van de repository is gewijzigd. Controleer de basisreferentie en probeer opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HEAD do repositório mudou. Revise a referência base e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HEAD репозитория изменился. Проверьте базу и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HEAD ของที่เก็บเปลี่ยนไป ตรวจสอบข้อมูลอ้างอิงฐานแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deponun HEAD’i değişti. Temel referansı inceleyip yeniden deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HEAD của kho đã thay đổi. Kiểm tra mốc cơ sở rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库 HEAD 已改变。请检查基准后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存庫 HEAD 已變更。請檢查基準後重試。"
          }
        }
      }
    },
    "The main checkout cannot be removed with a session.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إزالة نسخة العمل الرئيسية مع جلسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Haupt-Checkout kann nicht mit einer Sitzung entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar el checkout principal al cerrar una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout principal ne peut pas être supprimé avec une session."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout utama tidak dapat dihapus bersama sesi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout principale non può essere rimosso con una sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションと一緒にメインのチェックアウトは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션과 함께 기본 체크아웃을 제거할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdcheckout kan niet samen met een sessie worden verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout principal não pode ser removido com uma sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основную рабочую копию нельзя удалить вместе с сеансом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถนำเช็กเอาต์หลักออกพร้อมเซสชันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana checkout bir oturumla birlikte kaldırılamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa bản checkout chính cùng với phiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能随会话移除主检出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法隨工作階段移除主要簽出。"
          }
        }
      }
    },
    "The merge baseline is unavailable. Keep the worktree and review its branch in Git.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرجع الدمج غير متاح. احتفظ بشجرة العمل وراجع فرعها في Git."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Merge-Basisreferenz ist nicht verfügbar. Behalten Sie den Worktree und prüfen Sie den Zweig in Git."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La referencia de fusión no está disponible. Conserva el worktree y revisa su rama en Git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La référence de fusion est indisponible. Conservez le worktree et vérifiez sa branche dans Git."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Referensi penggabungan tidak tersedia. Pertahankan worktree dan tinjau cabangnya di Git."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riferimento di unione non è disponibile. Mantieni il worktree e controlla il ramo in Git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージの基準を利用できません。ワークツリーを保持し、Git でブランチを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 기준을 사용할 수 없습니다. 워크트리를 유지하고 Git에서 브랜치를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De samenvoegbasis is niet beschikbaar. Behoud de worktree en controleer de tak in Git."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A referência de mesclagem está indisponível. Mantenha o worktree e revise sua ramificação no Git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База слияния недоступна. Сохраните worktree и проверьте ветку в Git."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลอ้างอิงฐานสำหรับการรวมไม่พร้อมใช้งาน เก็บเวิร์กทรีไว้และตรวจสอบสาขาใน Git"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştirme temel referansı kullanılamıyor. Worktree’yi koruyup dalını Git’te inceleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mốc hợp nhất không khả dụng. Hãy giữ worktree và kiểm tra nhánh trong Git."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并基准不可用。请保留工作树并在 Git 中检查分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合併基準無法使用。請保留工作樹並在 Git 中檢查分支。"
          }
        }
      }
    },
