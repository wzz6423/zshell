    "HTTP, HTTPS, or SOCKS proxy URL. Changes apply to terminals opened afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP, HTTPS, or SOCKS proxy URL. Changes apply to terminals opened afterwards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP、HTTPS 或 SOCKS 代理 URL。修改只对之后新打开的终端生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
