            "value": "Alat diunduh, diinstal, dan diperbarui melalui instalasi Homebrew Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti vengono scaricati, installati e aggiornati tramite la tua installazione di Homebrew."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いの Homebrew でツールをダウンロード、インストール、アップデートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구는 설치된 Homebrew를 통해 다운로드, 설치 및 업데이트됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools worden via je Homebrew-installatie gedownload, geïnstalleerd en bijgewerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas são baixadas, instaladas e atualizadas pela sua instalação do Homebrew."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты загружаются, устанавливаются и обновляются через установленный Homebrew."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลด ติดตั้ง และอัปเดตเครื่องมือผ่าน Homebrew ที่ติดตั้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
