          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถนำเวิร์กทรีออกได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Worktree güvenli biçimde kaldırılamıyor."
          }
        },
        "vi": {
