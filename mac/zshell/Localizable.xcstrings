    "Arguments are parsed without a shell. Quotes and backslashes preserve argument boundaries.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحلّل الوسائط دون صدفة. تحافظ علامات الاقتباس والشرطات المائلة العكسية على حدود الوسائط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumente werden ohne Shell ausgewertet. Anführungszeichen und Backslashes bewahren die Argumentgrenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos se interpretan sin shell. Las comillas y las barras invertidas conservan los límites de cada argumento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arguments sont analysés sans shell. Les guillemets et barres obliques inverses préservent les limites des arguments."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumen diurai tanpa shell. Tanda kutip dan garis miring terbalik menjaga batas argumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti vengono analizzati senza una shell. Virgolette e barre rovesciate preservano i confini degli argomenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引数はシェルを介さずに解析されます。引用符とバックスラッシュで引数の区切りを保持できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인수는 셸 없이 분석됩니다. 따옴표와 역슬래시는 인수 경계를 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumenten worden zonder shell verwerkt. Aanhalingstekens en backslashes behouden de grenzen tussen argumenten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os argumentos são analisados sem um shell. Aspas e barras invertidas preservam os limites dos argumentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы разбираются без оболочки. Кавычки и обратная косая черта сохраняют границы аргументов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกอาร์กิวเมนต์โดยไม่ใช้เชลล์ เครื่องหมายคำพูดและแบ็กสแลชจะรักษาขอบเขตอาร์กิวเมนต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız değişkenler kabuk kullanılmadan ayrıştırılır. Tırnaklar ve ters eğik çizgiler değişken sınırlarını korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối số được phân tích không qua shell. Dấu ngoặc kép và dấu gạch chéo ngược giữ nguyên ranh giới đối số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数不经 Shell 解析。引号和反斜杠用于保留参数边界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參數不經 Shell 解析。引號和反斜槓用於保留參數邊界。"
          }
        }
      }
    },
