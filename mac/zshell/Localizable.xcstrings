    "The host can’t begin with “-” or contain whitespace.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يبدأ المضيف بـ «-» أو يحتوي على مسافات بيضاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host darf weder mit „-“ beginnen noch Leerraum enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El host no puede empezar por «-» ni contener espacios en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hôte ne peut pas commencer par « - » ni contenir d'espaces."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Host tidak boleh diawali “-” atau mengandung spasi kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'host non può iniziare con «-» né contenere spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストは「-」で始めたり、空白を含めたりできません。"
          }
        },
        "ko": {
