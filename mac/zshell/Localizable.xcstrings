    "Event timeouts must be between 0 and 86400000 milliseconds.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event timeouts must be between 0 and 86400000 milliseconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件等待超时必须介于 0 到 86400000 毫秒之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "事件等待逾時必須介於 0 到 86400000 毫秒之間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントの待機時間は 0～86400000 ミリ秒で指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
