    "Undo this rename? %@ will move to the Trash and %@ will be restored.": {
      "comment": "Rename discard confirmation. The placeholders are the new and old file names.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد التراجع عن إعادة التسمية؟ سيُنقل %@ إلى سلة المهملات وستُستعاد %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Umbenennen widerrufen? %@ wird in den Papierkorb gelegt und %@ wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Deshacer este cambio de nombre? %@ se moverá a la papelera y %@ se restaurará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler ce renommage ? %@ sera placé dans la corbeille et %@ sera restauré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Urungkan penggantian nama ini? %@ akan masuk ke Tong Sampah dan %@ dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullare questa rinomina? %@ verrà spostato nel Cestino e %@ verrà ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前の変更を取り消しますか？%@はゴミ箱に移動し、%@が復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 변경을 취소할까요? %@이(가) 휴지통으로 이동되고 %@이(가) 복원됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hernoemen ongedaan maken? %@ gaat naar de prullenmand en %@ wordt hersteld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer esta renomeação? %@ será movido para o Lixo e %@ será restaurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить переименование? %@ будет перемещён в Корзину, а %@ — восстановлен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลิกทำการเปลี่ยนชื่อนี้หรือไม่ %@ จะถูกย้ายไปยังถังขยะและ %@ จะถูกกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yeniden adlandırma geri alınsın mı? %@ Çöp Sepeti’ne taşınacak ve %@ geri yüklenecek."
          }
        },
        "vi": {
