          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %@? Il contenuto verrà spostato nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しますか？内容はゴミ箱に移動します。"
          }
