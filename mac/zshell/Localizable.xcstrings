        }
      }
    },
    "Templates cannot contain live session, history, agent, worktree, editor or diff state.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板不能包含运行中的会话、历史、agent、worktree、编辑器或 diff 状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本不能包含執行中的工作階段、歷史、agent、worktree、編輯器或 diff 狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートに実行中のセッション、履歴、エージェント、worktree、エディタ、差分の状態は含められません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿에는 실행 중인 세션, 기록, 에이전트, worktree, 편집기 또는 diff 상태를 포함할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles ne peuvent pas contenir l’état d’une session active, d’un historique, d’un agent, d’un worktree, d’un éditeur ou d’un diff."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorlagen dürfen keinen laufenden Sitzungs-, Verlaufs-, Agent-, Worktree-, Editor- oder Diff-Zustand enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas no pueden contener estados de sesiones activas, historial, agentes, worktrees, editores ni diferencias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos não podem conter estado de sessões ativas, histórico, agentes, worktrees, editores ou diffs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli non possono contenere lo stato di sessioni attive, cronologia, agenti, worktree, editor o diff."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjablonen kunnen geen toestand van actieve sessies, geschiedenis, agents, worktrees, editors of diffs bevatten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны не могут содержать состояние активных сессий, истории, агентов, worktree, редактора или diff."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تتضمن القوالب حالة جلسة نشطة أو سجل أو وكيل أو worktree أو محرر أو فروقات."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เทมเพลตไม่สามารถมีสถานะเซสชันที่กำลังทำงาน ประวัติ เอเจนต์ worktree ตัวแก้ไข หรือ diff"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat tidak dapat berisi status sesi aktif, riwayat, agen, worktree, editor, atau diff."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu không thể chứa trạng thái phiên đang chạy, lịch sử, agent, worktree, trình chỉnh sửa hoặc diff."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablonlar canlı oturum, geçmiş, aracı, worktree, düzenleyici veya diff durumu içeremez."
          }
        }
      }
    },
    "Use a project-relative directory without “..”, or an absolute directory.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用不含“..”的项目相对目录，或使用绝对目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用不含「..」的專案相對目錄，或使用絕對目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「..」を含まないプロジェクト相対ディレクトリか、絶対ディレクトリを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“..” 없는 프로젝트 상대 디렉터리 또는 절대 디렉터리를 사용하세요."
          }
        },
        "fr": {
