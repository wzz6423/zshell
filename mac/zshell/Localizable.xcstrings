    "A branch checked out in another worktree cannot be deleted": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حذف فرع مسجل في شجرة عمل أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in einem anderen Worktree ausgecheckter Branch kann nicht gelöscht werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar una rama extraída en otro worktree"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une branche extraite dans un autre worktree ne peut pas être supprimée"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch yang diperiksa di worktree lain tidak dapat dihapus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile eliminare un branch estratto in un altro worktree"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のワークツリーでチェックアウトされているブランチは削除できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 워크트리에서 체크아웃된 브랜치는 삭제할 수 없습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een branch die in een andere worktree is uitgecheckt kan niet worden verwijderd"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível excluir um branch em outro worktree"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя удалить ветку, выданную в другом worktree"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถลบสาขาที่เช็กเอาต์ในเวิร์กทรีอื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir worktree içinde checkout edilmiş dal silinemez"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa nhánh đang checkout trong worktree khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除在其他工作树中检出的分支"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除在其他工作樹中簽出的分支"
          }
        }
      }
    },
