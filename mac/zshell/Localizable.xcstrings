    "With a menu bar icon, closing the last workspace window keeps its terminals running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إظهار أيقونة شريط القوائم، يستمر تشغيل الطرفيات بعد إغلاق آخر نافذة لمساحة العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Menüleistensymbol laufen die Terminals weiter, wenn das letzte Arbeitsbereichsfenster geschlossen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un icono en la barra de menús, los terminales siguen ejecutándose al cerrar la última ventana del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une icône dans la barre des menus, fermer la dernière fenêtre de travail laisse ses terminaux en cours d’exécution."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan ikon bilah menu, terminal tetap berjalan saat jendela ruang kerja terakhir ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un’icona nella barra dei menu, i terminali continuano a funzionare quando chiudi l’ultima finestra dell’area di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンの表示中は、最後のワークスペースウインドウを閉じてもターミナルは動作し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘을 표시하면 마지막 작업 공간 윈도우를 닫아도 터미널이 계속 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een menubalksymbool blijven terminals actief wanneer je het laatste werkruimtevenster sluit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um ícone na barra de menus, os terminais continuam em execução ao fechar a última janela do espaço de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда значок в строке меню включён, терминалы продолжают работать после закрытия последнего окна рабочей области."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแสดงไอคอนในแถบเมนู เทอร์มินัลจะทำงานต่อไปหลังปิดหน้าต่างพื้นที่ทำงานสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu simgesi açıkken son çalışma alanı penceresini kapatmak terminalleri çalışır durumda tutar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có biểu tượng trên thanh menu, các terminal vẫn chạy sau khi đóng cửa sổ không gian làm việc cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
