          "stringUnit": {
            "state": "translated",
            "value": "Die SSH-Konfiguration muss eine vorhandene lesbare Datei mit absolutem Pfad sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración SSH debe ser un archivo existente y legible con ruta absoluta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração SSH deve ser um arquivo existente e legível em um caminho absoluto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione SSH deve essere un file esistente e leggibile con percorso assoluto."
          }
        },
        "nl": {
