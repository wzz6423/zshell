          "stringUnit": {
            "state": "translated",
            "value": "Dibuja un borde de acento alrededor del panel enfocado al dividir una pestaña"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine un contour accentué autour du volet actif lorsqu'un onglet est divisé"
          }
        },
        "id": {
          "stringUnit": {
