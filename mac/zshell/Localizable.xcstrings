    "This removes Zshell’s saved command history. Terminal output and your shell’s history are kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes Zshell’s saved command history. Terminal output and your shell’s history are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除 Zshell 保存的命令历史。终端输出和 Shell 自身的历史会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除 Zshell 儲存的命令歷史。終端機輸出和 Shell 本身的歷史會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell に保存されたコマンド履歴を削除します。ターミナル出力とシェル自体の履歴は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell에 저장된 명령 기록을 삭제합니다. 터미널 출력과 셸 자체의 기록은 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime l’historique enregistré par Zshell. La sortie du terminal et l’historique du shell sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den von Zshell gespeicherten Befehlsverlauf. Terminalausgabe und Shell-Verlauf bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el historial guardado por Zshell. La salida del terminal y el historial del shell se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o histórico salvo pelo Zshell. A saída do terminal e o histórico do shell são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove la cronologia salvata da Zshell. L’output del terminale e la cronologia della shell vengono conservati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de door Zshell opgeslagen geschiedenis. Terminaluitvoer en de geschiedenis van de shell blijven bewaard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет историю, сохранённую Zshell. Вывод терминала и история оболочки сохраняются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف سجل الأوامر المحفوظ في Zshell. تبقى مخرجات الطرفية وسجل الصدفة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบประวัติคำสั่งที่ Zshell บันทึกไว้ โดยเก็บผลลัพธ์เทอร์มินัลและประวัติของเชลล์ไว้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus riwayat yang disimpan Zshell. Keluaran terminal dan riwayat shell tetap tersimpan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa lịch sử lệnh Zshell đã lưu. Đầu ra terminal và lịch sử riêng của shell được giữ lại."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zshell’in kaydettiği komut geçmişini siler. Terminal çıktısı ve kabuk geçmişi korunur."
          }
        }
      }
    },
