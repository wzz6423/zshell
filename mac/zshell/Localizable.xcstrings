    "SSH configuration must be an existing readable file at an absolute path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 配置必须是绝对路径指向的现有可读文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
