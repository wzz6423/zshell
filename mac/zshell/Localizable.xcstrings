    "Conversation history could not be loaded or saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل سجل المحادثات أو حفظه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Unterhaltungsverlauf konnte nicht geladen oder gespeichert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation history could not be loaded or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar o guardar el historial de conversaciones."
          }
