    "Delete %@? Its contents will move to the Trash.": {
      "comment": "Discard confirmation. The placeholder is an untracked file name.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف %@؟ ستُنقل محتوياته إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löschen? Der Inhalt wird in den Papierkorb gelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Su contenido se moverá a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ? Son contenu sera placé dans la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %@? Isinya akan dipindahkan ke Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %@? Il contenuto verrà spostato nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しますか？内容はゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제할까요? 내용이 휴지통으로 이동됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwijderen? De inhoud wordt naar de prullenmand verplaatst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@? Seu conteúdo será movido para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@? Содержимое будет перемещено в Корзину."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@ หรือไม่ เนื้อหาจะถูกย้ายไปยังถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silinsin mi? İçeriği Çöp Sepeti’ne taşınacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %@? Nội dung sẽ được chuyển vào Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除 %@ 吗？其内容将移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除 %@ 嗎？其內容將移到垃圾桶。"
          }
        }
      }
    },
