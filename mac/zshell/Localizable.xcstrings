    "Discard the %lld reviewed changes? Untracked and moved files go to the Trash.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هل تريد تجاهل التغييرات التي تمت مراجعتها (%lld)؟ ستُنقل الملفات غير المتتبَّعة والمنقولة إلى سلة المهملات."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هل تريد تجاهل تغيير واحد تمت مراجعته (%lld)؟ ستُنقل الملفات غير المتتبَّعة والمنقولة إلى سلة المهملات."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هل تريد تجاهل تغييرين تمت مراجعتهما (%lld)؟ ستُنقل الملفات غير المتتبَّعة والمنقولة إلى سلة المهملات."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هل تريد تجاهل %lld تغييرات تمت مراجعتها؟ ستُنقل الملفات غير المتتبَّعة والمنقولة إلى سلة المهملات."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هل تريد تجاهل %lld تغييرًا تمت مراجعته؟ ستُنقل الملفات غير المتتبَّعة والمنقولة إلى سلة المهملات."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "هل تريد تجاهل %lld تغيير تمت مراجعته؟ ستُنقل الملفات غير المتتبَّعة والمنقولة إلى سلة المهملات."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die %lld geprüfte Änderung verwerfen? Unversionierte und verschobene Dateien werden in den Papierkorb gelegt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die %lld geprüften Änderungen verwerfen? Unversionierte und verschobene Dateien werden in den Papierkorb gelegt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Discard the %lld reviewed change? Untracked and moved files go to the Trash."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Discard the %lld reviewed changes? Untracked and moved files go to the Trash."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Descartar el %lld cambio revisado? Los archivos sin seguimiento y movidos irán a la papelera."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Descartar los %lld cambios revisados? Los archivos sin seguimiento y movidos irán a la papelera."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abandonner %lld modification examinée ? Les fichiers non suivis et déplacés seront placés dans la corbeille."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Abandonner les %lld modifications examinées ? Les fichiers non suivis et déplacés seront placés dans la corbeille."
                }
              }
            }
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang %lld perubahan yang ditinjau? File yang tidak dilacak dan dipindahkan akan masuk ke Tong Sampah."
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Scartare la %lld modifica revisionata? I file non tracciati e spostati finiranno nel Cestino."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Scartare le %lld modifiche revisionate? I file non tracciati e spostati finiranno nel Cestino."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認した変更%lld件を破棄しますか？未追跡と移動済みのファイルはゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토한 변경 사항 %lld개를 버릴까요? 추적되지 않는 파일과 이동된 파일은 휴지통으로 이동됩니다."
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De %lld beoordeelde wijziging verwerpen? Ongevolgde en verplaatste bestanden gaan naar de prullenmand."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De %lld beoordeelde wijzigingen verwerpen? Ongevolgde en verplaatste bestanden gaan naar de prullenmand."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Descartar a %lld alteração revisada? Arquivos não rastreados e movidos irão para o Lixo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Descartar as %lld alterações revisadas? Arquivos não rastreados e movidos irão para o Lixo."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Отменить %lld проверенное изменение? Неотслеживаемые и перемещённые файлы попадут в Корзину."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Отменить %lld проверенных изменения? Неотслеживаемые и перемещённые файлы попадут в Корзину."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Отменить %lld проверенных изменений? Неотслеживаемые и перемещённые файлы попадут в Корзину."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Отменить %lld проверенного изменения? Неотслеживаемые и перемещённые файлы попадут в Корзину."
                }
              }
            }
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละทิ้งการเปลี่ยนแปลงที่ตรวจทานแล้ว %lld รายการหรือไม่ ไฟล์ที่ไม่ติดตามและไฟล์ที่ย้ายจะไปยังถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelenen %lld değişiklik atılsın mı? İzlenmeyen ve taşınmış dosyalar Çöp Sepeti’ne gider."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy bỏ %lld thay đổi đã xem xét? Các tệp chưa được theo dõi và đã di chuyển sẽ vào Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要丢弃这 %lld 项已确认的更改吗？未跟踪和已移动的文件将移到废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要丟棄這 %lld 項已確認的變更嗎？未追蹤和已移動的檔案將移到垃圾桶。"
          }
        }
      }
    },
    "Discard this copy? %@ will move to the Trash.": {
      "comment": "Copy discard confirmation. The placeholder is a file name.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تجاهل هذه النسخة؟ سيُنقل %@ إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie verwerfen? %@ wird in den Papierkorb gelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar esta copia? %@ se moverá a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner cette copie ? %@ sera placé dans la corbeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang salinan ini? %@ akan dipindahkan ke Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartare questa copia? %@ verrà spostato nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
