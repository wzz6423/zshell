    "Reopened terminals show their previous scrollback above a fresh shell": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الطرفيات المعاد فتحها سجل التمرير السابق فوق صدفة جديدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieder geöffnete Terminals zeigen ihren bisherigen Scrollback über einer neuen Shell"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los terminales reabiertos muestran su historial anterior sobre un shell nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les terminaux rouverts affichent leur historique précédent au-dessus d'un nouveau shell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal yang dibuka kembali menampilkan riwayat gulir sebelumnya di atas shell baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I terminali riaperti mostrano la cronologia precedente sopra una nuova shell"
          }
        },
        "ja": {
          "stringUnit": {
