    "The command runs in a new terminal session using your login shell.": {
      "comment": "Explains what a Quick Launch command entry does.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُشغَّل الأمر في جلسة طرفية جديدة باستخدام صدفة تسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl wird in einer neuen Terminalsitzung mit deiner Login-Shell ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando se ejecuta en una nueva sesión de terminal con tu shell de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande s'exécute dans une nouvelle session de terminal avec votre shell de connexion."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah berjalan di sesi terminal baru memakai shell login Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando viene eseguito in una nuova sessione del terminale usando la shell di login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはログインシェルで新しいターミナルセッションとして実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 로그인 셸을 사용하여 새 터미널 세션에서 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opdracht wordt in een nieuwe terminalsessie met je inlogshell uitgevoerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando é executado em uma nova sessão de terminal usando seu shell de login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда запускается в новом сеансе терминала с вашей оболочкой входа."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งจะทำงานในเซสชันเทอร์มินัลใหม่โดยใช้ล็อกอินเชลล์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut, oturum açma kabuğunuzu kullanarak yeni bir terminal oturumunda çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lệnh chạy trong phiên terminal mới bằng shell đăng nhập của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
