            "value": "이벤트 제한 시간은 0~86400000밀리초여야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai doit être compris entre 0 et 86400000 millisecondes."
          }
        },
        "de": {
