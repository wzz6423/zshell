    "Pull remote commits, then push local ones": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سحب الالتزامات البعيدة ثم دفع المحلية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Commits pullen, dann lokale Commits pushen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traer commits remotos y luego enviar los locales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer les commits distants, puis pousser les commits locaux"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik commit remote, lalu dorong commit lokal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui pull dei commit remoti, poi push di quelli locali"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートのコミットをプルしてからローカルをプッシュ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 커밋을 풀한 다음 로컬 커밋 푸시"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe commits pullen en daarna lokale commits pushen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe os commits remotos e depois envie os locais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтянуть удалённые коммиты, затем отправить локальные"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงคอมมิตระยะไกลแล้วส่งคอมมิตในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzak commit’leri çek, ardından yerel olanları gönder"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo commit từ xa về rồi đẩy commit cục bộ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先拉取远程提交，再推送本地提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先拉取遠端提交，再推送本機提交"
          }
        }
      }
    },
