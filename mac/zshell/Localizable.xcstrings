    "`zshell +themes` needs an interactive terminal. Use `zshell +themes --list` to print theme names.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب `zshell +themes` طرفية تفاعلية. استخدم `zshell +themes --list` لطباعة أسماء السمات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` benötigt ein interaktives Terminal. Verwende `zshell +themes --list`, um Designnamen auszugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` necesita un terminal interactivo. Usa `zshell +themes --list` para mostrar los nombres de temas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` nécessite un terminal interactif. Utilisez `zshell +themes --list` pour afficher les noms des thèmes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` memerlukan terminal interaktif. Gunakan `zshell +themes --list` untuk mencetak nama tema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` richiede un terminale interattivo. Usa `zshell +themes --list` per stampare i nomi dei temi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes`には対話型ターミナルが必要です。テーマ名を表示するには`zshell +themes --list`を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes`에는 대화형 터미널이 필요합니다. 테마 이름을 출력하려면 `zshell +themes --list`를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` vereist een interactieve terminal. Gebruik `zshell +themes --list` om themanamen te tonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` precisa de um terminal interativo. Use `zshell +themes --list` para exibir os nomes dos temas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для `zshell +themes` нужен интерактивный терминал. Используйте `zshell +themes --list` для вывода имён тем."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` ต้องใช้เทอร์มินัลแบบโต้ตอบ ใช้ `zshell +themes --list` เพื่อพิมพ์ชื่อธีม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` etkileşimli terminal gerektirir. Tema adlarını yazdırmak için `zshell +themes --list` kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` cần terminal tương tác. Dùng `zshell +themes --list` để in tên chủ đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` 需要交互式终端。请使用 `zshell +themes --list` 列出主题名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell +themes` 需要交互式終端機。請使用 `zshell +themes --list` 列出主題名稱。"
          }
        }
      }
    },
    "`zshell` must be run inside a Zshell terminal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تشغيل `zshell` داخل طرفية Zshell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` muss in einem Zshell-Terminal ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` debe ejecutarse dentro de un terminal Zshell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` doit être exécuté dans un terminal Zshell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` harus dijalankan di dalam terminal Zshell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` deve essere eseguito in un terminale Zshell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell`はZshellのターミナル内で実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell`은 Zshell 터미널 안에서 실행해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` moet in een Zshell-terminal worden uitgevoerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` deve ser executado dentro de um terminal Zshell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` нужно запускать внутри терминала Zshell."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องเรียกใช้ `zshell` ภายในเทอร์มินัล Zshell"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell`, bir Zshell terminalinde çalıştırılmalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phải chạy `zshell` bên trong terminal Zshell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` 必须在 Zshell 终端内运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`zshell` 必須在 Zshell 終端機內執行。"
          }
        }
      }
    },
