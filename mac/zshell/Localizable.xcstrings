    "These settings apply only to terminals created after you save. Existing terminal processes are unchanged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق هذه الإعدادات فقط على الطرفيات المنشأة بعد الحفظ. لا تتغيّر عمليات الطرفية الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen gelten nur für nach dem Sichern erstellte Terminals. Bestehende Terminalprozesse bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos ajustes solo se aplican a terminales creados después de guardar. Los procesos de terminal existentes no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages ne s'appliquent qu'aux terminaux créés après l'enregistrement. Les processus de terminal existants restent inchangés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan ini hanya berlaku pada terminal yang dibuat setelah disimpan. Proses terminal yang sudah ada tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni si applicano solo ai terminali creati dopo il salvataggio. I processi del terminale esistenti restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの設定は、保存後に作成されたターミナルにのみ適用されます。既存のターミナルプロセスは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 저장 후 생성되는 터미널에만 적용됩니다. 기존 터미널 프로세스는 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze instellingen gelden alleen voor terminals die na het bewaren worden aangemaakt. Bestaande terminalprocessen blijven ongewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes ajustes se aplicam apenas a terminais criados após salvar. Os processos de terminal existentes não são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки применяются только к терминалам, созданным после сохранения. Существующие процессы терминалов не меняются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่านี้มีผลเฉพาะเทอร์มินัลที่สร้างหลังบันทึก โปรเซสเทอร์มินัลเดิมจะไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayarlar yalnızca kaydettikten sonra oluşturulan terminallere uygulanır. Mevcut terminal işlemleri değişmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt này chỉ áp dụng cho terminal tạo sau khi lưu. Tiến trình terminal hiện có không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置仅应用于保存后新建的终端。现有终端进程不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些設定僅應用於儲存後新增的終端機。現有終端機程序不會改變。"
          }
        }
      }
    },
    "Thicken font strokes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زيادة سُمك الخطوط"
