          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับคำขอถัดไปในทุกบานหน้าต่างเบราว์เซอร์ โหลดหน้าใหม่หลังเปลี่ยนกฎ"
