    "The update is being downloaded and verified in the background. Zshell will restart automatically when it is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري تنزيل التحديث والتحقق منه في الخلفية. سيُعاد تشغيل Zshell تلقائيًا عند جاهزيته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wird im Hintergrund geladen und geprüft. Zshell startet automatisch neu, sobald es bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización se descarga y verifica en segundo plano. Zshell se reiniciará automáticamente cuando esté lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour est téléchargée et vérifiée en arrière-plan. Zshell redémarrera automatiquement dès qu'elle sera prête."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan sedang diunduh dan diverifikasi di latar belakang. Zshell akan dimulai ulang otomatis setelah siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento viene scaricato e verificato in background. Zshell si riavvierà automaticamente quando sarà pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでアップデートをダウンロードして検証しています。準備ができ次第、Zshell は自動的に再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 업데이트를 다운로드하고 검증 중입니다. 준비가 되면 Zshell이 자동으로 재시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De update wordt op de achtergrond gedownload en gecontroleerd. Zshell herstart automatisch zodra deze klaar is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização está sendo baixada e verificada em segundo plano. O Zshell reiniciará automaticamente quando estiver pronta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление загружается и проверяется в фоне. Zshell автоматически перезапустится, когда оно будет готово."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดาวน์โหลดและตรวจสอบการอัปเดตเบื้องหลัง Zshell จะเริ่มใหม่อัตโนมัติเมื่อพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme arka planda indiriliyor ve doğrulanıyor. Hazır olduğunda Zshell otomatik yeniden başlayacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản cập nhật đang được tải và xác minh trong nền. Zshell sẽ tự động khởi động lại khi sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在后台下载并验证更新。准备就绪后，Zshell 将自动重启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在後台下載並驗證更新。準備就緒後，Zshell 將自動重啟。"
          }
        }
      }
    },
