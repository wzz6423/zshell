            "value": "再度開いたターミナルでは、新しいシェルの上に以前のスクロール履歴が表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연 터미널은 새 셸 위에 이전 스크롤 기록을 표시합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
