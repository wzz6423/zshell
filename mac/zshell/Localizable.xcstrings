        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt den Warnton und zeigt visuelle macOS-Hinweise, wenn Terminalprogramme ein Klingelsignal ausgeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el sonido de alerta y usa alertas visuales de macOS cuando los programas del terminal activan la campana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue le son d'alerte et utilise les alertes visuelles macOS lorsque les programmes du terminal font sonner la cloche"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar suara peringatan dan memakai peringatan visual macOS saat program terminal membunyikan bel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce il suono di avviso e usa gli avvisi visivi di macOS quando i programmi del terminale attivano la campanella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルプログラムがベルを鳴らしたときに警告音を再生し、macOSの視覚通知を使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 프로그램이 벨을 울리면 경고음을 재생하고 macOS 시각적 알림을 사용합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt het waarschuwingsgeluid en toont visuele macOS-meldingen wanneer terminalprogramma's de bel laten rinkelen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o som de alerta e usa alertas visuais do macOS quando programas do terminal acionam a campainha"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводит звук и визуальные уведомления macOS при сигнале терминальной программы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นเสียงเตือนและใช้การแจ้งเตือนภาพของ macOS เมื่อโปรแกรมเทอร์มินัลส่งเสียงกระดิ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal programları zil çaldığında uyarı sesi ve macOS görsel uyarılarını kullanır"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát âm báo và dùng cảnh báo trực quan macOS khi chương trình terminal rung chuông"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端程序触发铃声时播放提示音，并使用 macOS 视觉提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機程式觸發鈴聲時播放提示音，並使用 macOS 視覺提醒"
          }
        }
      }
    },
