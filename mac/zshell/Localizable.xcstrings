    "Pasting this text to the terminal may be dangerous because it looks like one or more commands may execute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون لصق هذا النص في الطرفية خطيرًا، إذ يبدو أن أمرًا أو أكثر قد يُنفّذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Einfügen dieses Textes ins Terminal kann gefährlich sein, da dabei möglicherweise ein oder mehrere Befehle ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar este texto en el terminal puede ser peligroso porque parece que se ejecutarán uno o más comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller ce texte dans le terminal peut être dangereux, car il semble qu'une ou plusieurs commandes pourraient s'exécuter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menempelkan teks ini ke terminal mungkin berbahaya karena satu atau beberapa perintah tampaknya dapat dijalankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incollare questo testo nel terminale può essere pericoloso perché sembra che possano essere eseguiti uno o più comandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストには実行されそうなコマンドが含まれているため、ターミナルへの貼り付けは危険な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 명령이 실행될 수 있어 이 텍스트를 터미널에 붙여넣는 것은 위험할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tekst in de terminal plakken kan gevaarlijk zijn omdat er mogelijk een of meer opdrachten worden uitgevoerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colar este texto no terminal pode ser perigoso porque parece que um ou mais comandos podem ser executados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставка этого текста в терминал может быть опасна: возможно выполнение одной или нескольких команд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวางข้อความนี้ในเทอร์มินัลอาจอันตราย เพราะอาจมีคำสั่งอย่างน้อยหนึ่งคำสั่งถูกเรียกใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veya daha fazla komut çalışabilecek gibi göründüğünden bu metni terminale yapıştırmak tehlikeli olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán văn bản này vào terminal có thể nguy hiểm vì có vẻ một hoặc nhiều lệnh sẽ được thực thi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此文本粘贴到终端可能有风险，因为其中似乎包含会被执行的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此文字貼上到終端機可能有風險，因為其中似乎包含會被執行的命令。"
          }
        }
      }
    },
