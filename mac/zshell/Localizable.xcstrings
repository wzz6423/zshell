    "Type a label to copy. Tab opens. Esc cancels.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a label to copy. Tab opens. Esc cancels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入字母标签复制。Tab 切换打开，Esc 取消。"
