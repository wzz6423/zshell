    "Using cached rules: %lld filters converted; %lld unsupported filters skipped. The update failed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using cached rules: %lld filters converted; %lld unsupported filters skipped. The update failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用缓存规则：已转换 %lld 条，跳过 %lld 条不支持的规则。更新失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用快取規則：已轉換 %lld 條，略過 %lld 條不支援的規則。更新失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを使用中：%lld 件を変換、未対応の %lld 件をスキップ。更新に失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시 규칙 사용 중: %lld개 변환, 미지원 %lld개 건너뜀. 업데이트에 실패했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles en cache : %lld filtres convertis ; %lld ignorés. La mise à jour a échoué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeicherte Regeln: %lld Filter konvertiert; %lld übersprungen. Aktualisierung fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas en caché: %lld filtros convertidos; %lld omitidos. Falló la actualización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras em cache: %lld filtros convertidos; %lld ignorados. A atualização falhou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regole in cache: %lld filtri convertiti; %lld ignorati. Aggiornamento non riuscito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cacheregels: %lld filters omgezet; %lld overgeslagen. Bijwerken mislukt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила из кеша: преобразовано: %lld; пропущено: %lld. Обновление не удалось."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قواعد مخزنة مؤقتًا: تم تحويل %lld مرشحًا وتخطي %lld. فشل التحديث."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กฎที่แคชไว้: แปลง %lld รายการ ข้าม %lld รายการ การอัปเดตล้มเหลว"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan cache: %lld filter dikonversi; %lld dilewati. Pembaruan gagal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng quy tắc đã lưu: chuyển đổi %lld bộ lọc; bỏ qua %lld. Cập nhật thất bại."
          }
        },
        "tr": {
