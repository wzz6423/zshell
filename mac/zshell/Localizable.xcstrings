    "Stream live events from this terminal's project as NDJSON. Use --pane UUID, --event NAME, --once, and --timeout MS (0 waits indefinitely).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream live events from this terminal's project as NDJSON. Use --pane UUID, --event NAME, --once, and --timeout MS (0 waits indefinitely)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 NDJSON 订阅当前终端所属项目的实时事件。支持 --pane UUID、--event NAME、--once 和 --timeout MS（0 表示无限等待）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以 NDJSON 訂閱目前終端機所屬專案的即時事件。支援 --pane UUID、--event NAME、--once 和 --timeout MS（0 表示無限等待）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルのプロジェクトのイベントを NDJSON で購読します。--pane UUID、--event NAME、--once、--timeout MS（0 は無期限）を指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널의 프로젝트 이벤트를 NDJSON으로 구독합니다. --pane UUID, --event NAME, --once, --timeout MS를 사용하세요(0은 무제한 대기)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les événements du projet de ce terminal en NDJSON. Options : --pane UUID, --event NAME, --once et --timeout MS (0 attend indéfiniment)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektereignisse dieses Terminals als NDJSON abonnieren. Optionen: --pane UUID, --event NAME, --once und --timeout MS (0 wartet unbegrenzt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe los eventos del proyecto de esta terminal en NDJSON. Usa --pane UUID, --event NAME, --once y --timeout MS (0 espera indefinidamente)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe os eventos do projeto deste terminal em NDJSON. Use --pane UUID, --event NAME, --once e --timeout MS (0 aguarda indefinidamente)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui gli eventi del progetto di questo terminale in NDJSON. Usa --pane UUID, --event NAME, --once e --timeout MS (0 attende senza limiti)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg gebeurtenissen van het project van deze terminal als NDJSON. Gebruik --pane UUID, --event NAME, --once en --timeout MS (0 wacht onbeperkt)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка на события проекта этого терминала в NDJSON. Параметры: --pane UUID, --event NAME, --once и --timeout MS (0 — без ограничения)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك في أحداث مشروع هذه الطرفية بصيغة NDJSON. استخدم --pane UUID و--event NAME و--once و--timeout MS (القيمة 0 للانتظار دون حد)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามเหตุการณ์โครงการของเทอร์มินัลนี้เป็น NDJSON ใช้ --pane UUID, --event NAME, --once และ --timeout MS (0 คือรอไม่จำกัด)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
