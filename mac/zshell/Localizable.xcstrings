    "No default branch was found. Choose Current HEAD or an explicit baseline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على فرع افتراضي. اختر HEAD الحالي أو مرجعًا أساسيًا صريحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Standardzweig gefunden. Wählen Sie Aktueller HEAD oder eine explizite Basisreferenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una rama predeterminada. Elige HEAD actual o una referencia explícita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune branche par défaut trouvée. Choisissez HEAD actuel ou une référence explicite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
