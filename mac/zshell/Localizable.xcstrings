        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไดเรกทอรีที่สัมพันธ์กับโปรเจ็กต์โดยไม่มี “..” หรือใช้ไดเรกทอรีแบบสัมบูรณ์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan direktori relatif terhadap proyek tanpa “..”, atau direktori absolut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thư mục tương đối so với dự án không chứa “..”, hoặc thư mục tuyệt đối."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“..” içermeyen proje göreli bir dizin veya mutlak bir dizin kullanın."
          }
        }
      }
    },
    "The directory “%@” is unavailable. Choose another project root or edit the template.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录“%@”不可用。请选择其他项目根目录或编辑模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目錄「%@」無法使用。請選擇其他專案根目錄或編輯範本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディレクトリ「%@」は利用できません。別のプロジェクトルートを選ぶかテンプレートを編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 디렉터리를 사용할 수 없습니다. 다른 프로젝트 루트를 선택하거나 템플릿을 편집하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier « %@ » est indisponible. Choisissez une autre racine de projet ou modifiez le modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verzeichnis „%@“ ist nicht verfügbar. Wählen Sie eine andere Projektwurzel oder bearbeiten Sie die Vorlage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio «%@» no está disponible. Elige otra raíz de proyecto o edita la plantilla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório “%@” não está disponível. Escolha outra raiz de projeto ou edite o modelo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La directory “%@” non è disponibile. Scegli un’altra radice del progetto o modifica il modello."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De map “%@” is niet beschikbaar. Kies een andere projecthoofdmap of bewerk het sjabloon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог «%@» недоступен. Выберите другой корень проекта или отредактируйте шаблон."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجلد «%@» غير متاح. اختر جذر مشروع آخر أو حرّر القالب."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดเรกทอรี “%@” ไม่พร้อมใช้งาน เลือกรากของโปรเจ็กต์อื่นหรือแก้ไขเทมเพลต"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktori “%@” tidak tersedia. Pilih akar proyek lain atau edit templat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục “%@” không khả dụng. Chọn thư mục gốc dự án khác hoặc chỉnh sửa mẫu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” dizini kullanılamıyor. Başka bir proje kökü seçin veya şablonu düzenleyin."
          }
        }
      }
    },
    "Use a valid startup program and arguments, or a login-shell initialization command.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用有效的启动程序和参数，或登录 shell 初始化命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用有效的啟動程式和引數，或登入 shell 初始化命令。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な起動プログラムと引数、またはログインシェルの初期化コマンドを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바른 시작 프로그램과 인수 또는 로그인 셸 초기화 명령을 사용하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un programme de démarrage et des arguments valides, ou une commande d’initialisation du shell de connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein gültiges Startprogramm mit Argumenten oder einen Initialisierungsbefehl für die Login-Shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un programa de inicio y argumentos válidos, o un comando de inicialización del shell de inicio de sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um programa de inicialização e argumentos válidos, ou um comando de inicialização do shell de login."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un programma di avvio con argomenti validi oppure un comando di inizializzazione della shell di login."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een geldig startprogramma met argumenten of een initialisatieopdracht voor de aanmeldshell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте корректную программу запуска с аргументами или команду инициализации оболочки входа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم برنامج بدء ووسائط صالحة، أو أمر تهيئة لصدفة تسجيل الدخول."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้โปรแกรมเริ่มต้นและอาร์กิวเมนต์ที่ถูกต้อง หรือคำสั่งเริ่มต้นของเชลล์เข้าสู่ระบบ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan program awal dan argumen yang valid, atau perintah inisialisasi shell login."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng chương trình khởi động và đối số hợp lệ, hoặc lệnh khởi tạo shell đăng nhập."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli bir başlangıç programı ve bağımsız değişkenler veya oturum açma kabuğu başlatma komutu kullanın."
          }
        }
      }
    },
    "The startup program “%@” is not an executable file on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动程序“%@”不是这台 Mac 上的可执行文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動程式「%@」不是這台 Mac 上的可執行檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動プログラム「%@」はこの Mac 上の実行可能ファイルではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 프로그램 “%@”은(는) 이 Mac의 실행 파일이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme de démarrage « %@ » n’est pas un fichier exécutable sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startprogramm „%@“ ist auf diesem Mac keine ausführbare Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa de inicio «%@» no es un archivo ejecutable en este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa de inicialização “%@” não é um arquivo executável neste Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma di avvio “%@” non è un file eseguibile su questo Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het startprogramma “%@” is geen uitvoerbaar bestand op deze Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа запуска «%@» не является исполняемым файлом на этом Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج البدء «%@» ليس ملفًا قابلاً للتنفيذ على هذا الـ Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรแกรมเริ่มต้น “%@” ไม่ใช่ไฟล์ที่เรียกใช้ได้บน Mac เครื่องนี้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program awal “%@” bukan file yang dapat dieksekusi di Mac ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chương trình khởi động “%@” không phải tệp thực thi trên Mac này."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” başlangıç programı bu Mac’te çalıştırılabilir bir dosya değil."
          }
        }
      }
    },
    "Template browser pages must use HTTP or HTTPS URLs without embedded credentials.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板浏览器页面必须使用不含内嵌凭据的 HTTP 或 HTTPS URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範本瀏覽器頁面必須使用不含內嵌憑證的 HTTP 或 HTTPS URL。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートのブラウザページは認証情報を含まない HTTP または HTTPS の URL を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿 브라우저 페이지는 자격 증명이 포함되지 않은 HTTP 또는 HTTPS URL을 사용해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages du navigateur du modèle doivent utiliser des URL HTTP ou HTTPS sans identifiants intégrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserseiten in Vorlagen müssen HTTP- oder HTTPS-URLs ohne eingebettete Zugangsdaten verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas del navegador de la plantilla deben usar URL HTTP o HTTPS sin credenciales incrustadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas do navegador do modelo devem usar URLs HTTP ou HTTPS sem credenciais incorporadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine del browser del modello devono usare URL HTTP o HTTPS senza credenziali incorporate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserpagina’s in sjablonen moeten HTTP- of HTTPS-URL’s zonder ingesloten inloggegevens gebruiken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы браузера в шаблоне должны использовать URL HTTP или HTTPS без встроенных учётных данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تستخدم صفحات المتصفح في القالب عناوين HTTP أو HTTPS دون بيانات اعتماد مضمنة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าเบราว์เซอร์ในเทมเพลตต้องใช้ URL แบบ HTTP หรือ HTTPS ที่ไม่มีข้อมูลรับรองฝังอยู่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman browser templat harus memakai URL HTTP atau HTTPS tanpa kredensial tertanam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang trình duyệt trong mẫu phải dùng URL HTTP hoặc HTTPS không chứa thông tin xác thực."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablon tarayıcı sayfaları gömülü kimlik bilgileri içermeyen HTTP veya HTTPS URL’leri kullanmalıdır."
          }
        }
      }
    },
    "The workspace template library could not be loaded. Restore or remove the library file before saving templates.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载工作区模板库。保存模板前，请恢复或移除模板库文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入工作區範本庫。儲存範本前，請還原或移除範本庫檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペーステンプレートライブラリを読み込めませんでした。テンプレートを保存する前にライブラリファイルを復元または削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 템플릿 라이브러리를 불러올 수 없습니다. 템플릿을 저장하기 전에 라이브러리 파일을 복원하거나 제거하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque de modèles n’a pas pu être chargée. Restaurez ou supprimez son fichier avant d’enregistrer des modèles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorlagenbibliothek konnte nicht geladen werden. Stellen Sie die Bibliotheksdatei wieder her oder entfernen Sie sie, bevor Sie Vorlagen sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la biblioteca de plantillas. Restaura o elimina el archivo de biblioteca antes de guardar plantillas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a biblioteca de modelos. Restaure ou remova o arquivo da biblioteca antes de salvar modelos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la libreria di modelli. Ripristina o rimuovi il file della libreria prima di salvare modelli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sjabloonbibliotheek kon niet worden geladen. Herstel of verwijder het bibliotheekbestand voordat u sjablonen bewaart."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить библиотеку шаблонов. Восстановите или удалите файл библиотеки перед сохранением шаблонов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل مكتبة قوالب مساحة العمل. استعد ملف المكتبة أو أزله قبل حفظ القوالب."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดคลังเทมเพลตพื้นที่ทำงานไม่ได้ โปรดกู้คืนหรือลบไฟล์คลังก่อนบันทึกเทมเพลต"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka templat ruang kerja tidak dapat dimuat. Pulihkan atau hapus file pustaka sebelum menyimpan templat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải thư viện mẫu không gian làm việc. Khôi phục hoặc xóa tệp thư viện trước khi lưu mẫu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanı şablonu kitaplığı yüklenemedi. Şablon kaydetmeden önce kitaplık dosyasını geri yükleyin veya kaldırın."
          }
        }
      }
    },
